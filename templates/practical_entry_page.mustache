{{!
    Practical Entry Page — trainer enters competency achievement % per student.
    @package local_comp_report_ext
}}
<div class="local-competency-practical-entry">

    {{! ─── Filter selectors ─── }}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fa fa-tools me-2"></i>{{#str}}practicalentry, local_comp_report_ext{{/str}}</h5>
        </div>
        <div class="card-body">
            {{^hasassessments}}
            <div class="alert alert-warning mb-0">
                <i class="fa fa-exclamation-triangle me-2"></i>
                {{strnopracticals}}
                <a href="{{setupurl}}" class="alert-link ms-1">
                    {{#str}}goassessmentsetup, local_comp_report_ext{{/str}}
                </a>
            </div>
            {{/hasassessments}}

            {{#hasassessments}}
            <form method="get" action="{{filteraction}}" class="row g-3 align-items-end">
                <input type="hidden" name="courseid" value="{{courseid}}">

                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        <i class="fa fa-clipboard-list me-1"></i>{{strselectassessment}}
                    </label>
                    <select name="assessmentid" class="form-select">
                        <option value="0">— {{strselectassessment}} —</option>
                        {{#assessments}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>
                            {{name}} ({{weight}}%)
                        </option>
                        {{/assessments}}
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        <i class="fa fa-star me-1"></i>{{strselectcompetency}}
                    </label>
                    <select name="competencyid" class="form-select">
                        <option value="0">— {{strselectcompetency}} —</option>
                        {{#competencies}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{shortname}}</option>
                        {{/competencies}}
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fa fa-eye me-1"></i> {{strshowstudents}}
                    </button>
                </div>
            </form>
            {{/hasassessments}}
        </div>
    </div>

    {{! ─── Student Result Entry Form ─── }}
    {{#hasselection}}
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fa fa-users me-2"></i>{{#str}}enterstudentresults, local_comp_report_ext{{/str}}
            </h5>
        </div>
        <div class="card-body p-0">
            {{#hasstudents}}
            <form method="post" action="{{formaction}}">
                <input type="hidden" name="sesskey"      value="{{sesskey}}">
                <input type="hidden" name="assessmentid" value="{{assessmentid}}">
                <input type="hidden" name="competencyid" value="{{competencyid}}">
                <input type="hidden" name="courseid"     value="{{courseid}}">

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px">#</th>
                                <th>{{strstudent}}</th>
                                <th style="width:120px">{{#str}}idnumber{{/str}}</th>
                                <th style="width:200px" class="text-center">
                                    {{strpercent}} (0–100)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#students}}
                            <tr>
                                <td class="text-muted small">{{@index}}</td>
                                <td>
                                    <strong>{{fullname}}</strong>
                                    <input type="hidden" name="studentid[]" value="{{id}}">
                                </td>
                                <td class="text-muted small">{{idnumber}}</td>
                                <td class="text-center">
                                    <div class="input-group input-group-sm justify-content-center" style="max-width:140px;margin:auto">
                                        <input type="number"
                                               name="competency_percent[]"
                                               class="form-control text-center"
                                               min="0" max="100" step="0.5"
                                               value="{{percent}}"
                                               placeholder="—">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </td>
                            </tr>
                            {{/students}}
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center">
                    <span class="text-muted small">
                        <i class="fa fa-info-circle me-1"></i>
                        {{#str}}practicalentryhintsave, local_comp_report_ext{{/str}}
                    </span>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i> {{strsave}}
                    </button>
                </div>
            </form>
            {{/hasstudents}}
            {{^hasstudents}}
            <div class="text-center py-5 text-muted">
                <i class="fa fa-user-slash fa-3x mb-3 d-block opacity-50"></i>
                <p>{{strnostudenst}}</p>
            </div>
            {{/hasstudents}}
        </div>
    </div>
    {{/hasselection}}

</div>

<style>
.local-competency-practical-entry .card { border-radius: 0.75rem; overflow: hidden; }
.local-competency-practical-entry .table th { font-size: .85rem; }
</style>
