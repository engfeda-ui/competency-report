    @template local_comp_report_ext/teacher_panel

    Example context (json):
    {
        "courseid": 5,
        "userid": 2,
        "quizid": 10,
        "students": [
            { "id": 1, "name": "Ali YÄ±lmaz", "selected": false },
            { "id": 2, "name": "AyÅŸe Demir", "selected": true }
        ],
        "quizzes": [
            { "id": 10, "name": "Matematik Vize", "selected": true },
            { "id": 11, "name": "Fizik Final", "selected": false }
        ],
        "has_rows": true,
        "rows": [
            {
                "shortname": "Y01",
                "attempts": 5,
                "correct": 4,
                "rate": "80",
                "rowclass": "table-success"
            }
        ],
        "chart_config": "{\"labels\":[\"Y01\"], \"values\":[80], \"label\":\"Success Rate\"}"
    }
}}
<div class="local_comp_report_ext_teacher_panel">
    {{! Display the moodleform }}
    <div class="card mb-4 border-0 shadow-sm bg-light">
        <div class="card-body">
            {{{form_html}}}
        </div>
    </div>

    {{#has_selection}}
        {{#has_rows}}
            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-outline-secondary btn-sm mr-2" onclick="window.print()">
                    <i class="fa fa-print mr-1"></i> {{#str}}print, core{{/str}}
                </button>
                <button type="button" id="btn-export-teacher-exam-excel" class="btn btn-outline-success btn-sm">
                    <i class="fa fa-file-excel-o mr-1"></i> {{#str}}exportexcel, local_comp_report_ext{{/str}}
                </button>
            </div>

            {{! Data Table }}
            <div class="table-responsive">
                <table id="teacher-student-exam-table" class="generaltable table table-hover shadow-sm bg-white border">
                    <thead class="thead-dark">
                        <tr>
                            <th>{{#str}}competency, local_comp_report_ext{{/str}}</th>
                            <th class="text-center">{{#str}}questioncount, local_comp_report_ext{{/str}}</th>
                            <th class="text-center">{{#str}}correctcount, local_comp_report_ext{{/str}}</th>
                            <th class="text-center">{{#str}}successrate, local_comp_report_ext{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                        <tr class="{{rowclass}}">
                            <td><strong>{{shortname}}</strong></td>
                            <td class="text-center">{{attempts}}</td>
                            <td class="text-center">{{correct}}</td>
                            <td class="text-center font-weight-bold">%{{rate}}</td>
                        </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>

            {{! Chart Container }}
            <div class="card mt-4 p-4 shadow-sm bg-white border-0">
                <div style="position: relative; height:45vh; width:100%">
                    <canvas id="teacher_student_chart" data-config="{{chart_config}}"></canvas>
                </div>
            </div>

            {{! Reusable AI Commentary & Focus Analysis Widget }}
            {{> local_comp_report_ext/ai_commentary_widget }}
        {{/has_rows}}

        {{^has_rows}}
            {{! No data alert }}
            <div class="alert alert-info shadow-sm mt-3">
                <i class="fa fa-info-circle mr-2"></i> {{#str}}nodatafound, local_comp_report_ext{{/str}}
            </div>
        {{/has_rows}}
    {{/has_selection}}
</div>

{{#js}}
require(['jquery', 'local_comp_report_ext/visualizer'], function($, Visualizer) {
    const canvas = document.getElementById('teacher_student_chart');
    if (canvas) {
        const config = JSON.parse(canvas.getAttribute('data-config'));
        Visualizer.initBarChart('teacher_student_chart', config.labels, config.values, config.label);
    }

    $('#btn-export-teacher-exam-excel').on('click', function() {
        var rows = [];
        rows.push(['"{{#str}}competency, local_comp_report_ext{{/str}}"', '"{{#str}}questioncount, local_comp_report_ext{{/str}}"', '"{{#str}}correctcount, local_comp_report_ext{{/str}}"', '"{{#str}}successrate, local_comp_report_ext{{/str}}"'].join(','));
        $('#teacher-student-exam-table tbody tr').each(function() {
            var cols = [];
            $(this).find('td').each(function() {
                var text = $(this).text().replace(/\s+/g, ' ').trim();
                cols.push('"' + text.replace(/"/g, '""') + '"');
            });
            if (cols.length) { rows.push(cols.join(',')); }
        });
        var csvContent = '\uFEFF' + rows.join('\n');
        var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Teacher_Student_Exam_Analysis_' + new Date().toISOString().slice(0,10) + '.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
});
{{/js}}
