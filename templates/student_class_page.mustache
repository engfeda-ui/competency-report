    @template local_comp_report_ext/student_analysis

    Example context (json):
    {
        "has_data": true,
        "rows": [
            {
                "shortname": "Matematik",
                "courserate": "75",
                "classrate": "65",
                "myrate": "80",
                "colorclass": "text-success"
            }
        ],
        "chart_config": "{\"labels\":[\"Matematik\"],\"datasets\":[]}"
    }
}}
<div class="local_comp_report_ext_student_analysis">
    <!-- Consolidated Student Tab Navigation -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link {{#active_reportcard}}active font-weight-bold{{/active_reportcard}}{{^active_reportcard}}text-muted{{/active_reportcard}}" href="student_report.php?courseid={{courseid}}"><i class="fa fa-vcard-o mr-1"></i> {{#str}}myreportcard, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_examanalysis}}active font-weight-bold{{/active_examanalysis}}{{^active_examanalysis}}text-muted{{/active_examanalysis}}" href="student_exam.php?courseid={{courseid}}"><i class="fa fa-bar-chart mr-1"></i> {{#str}}myexamanalysis, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencyexams}}active font-weight-bold{{/active_competencyexams}}{{^active_competencyexams}}text-muted{{/active_competencyexams}}" href="student_competency_exams.php?courseid={{courseid}}"><i class="fa fa-list-alt mr-1"></i> {{#str}}mycompetencyexams, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencystate}}active font-weight-bold{{/active_competencystate}}{{^active_competencystate}}text-muted{{/active_competencystate}}" href="student_class.php?courseid={{courseid}}"><i class="fa fa-graduation-cap mr-1"></i> {{#str}}mycompetencystate, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_timeline}}active font-weight-bold{{/active_timeline}}{{^active_timeline}}text-muted{{/active_timeline}}" href="timeline.php?courseid={{courseid}}"><i class="fa fa-calendar mr-1"></i> {{#str}}timeline, local_comp_report_ext{{/str}}</a>
        </li>
    </ul>

    {{#has_data}}
        <div class="d-flex justify-content-end mb-2">
            <button type="button" class="btn btn-outline-secondary btn-sm mr-2" onclick="window.print()">
                <i class="fa fa-print mr-1"></i> {{#str}}print, core{{/str}}
            </button>
            <button type="button" id="btn-export-student-class-excel" class="btn btn-outline-success btn-sm">
                <i class="fa fa-file-excel-o mr-1"></i> {{#str}}exportexcel, local_comp_report_ext{{/str}}
            </button>
        </div>

        {{! Comparison Table }}
        <div class="table-responsive">
            <table id="student-class-table" class="generaltable table-hover mt-3 shadow-sm bg-white border w-100">
                <thead class="thead-dark">
                    <tr>
                        <th>{{#str}}competencyname, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}courseavg, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}classavg, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}myavg, local_comp_report_ext{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <td><strong>{{shortname}}</strong></td>
                        <td class="text-center text-muted">%{{courserate}}</td>
                        <td class="text-center text-muted">%{{classrate}}</td>
                        <td class="text-center font-weight-bold {{colorclass}}" style="font-size:1.1em">
                            %{{myrate}}
                        </td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>

        {{! Comparative Chart Area }}
        <div class="card mt-4 p-4 shadow-sm bg-white border-0">
            <div style="height:400px; min-height:400px; width:100%; position: relative;">
                <canvas id="studentClassChart" data-chart-config="{{chart_config}}"></canvas>
            </div>
        </div>

        {{! Reusable AI Commentary & Focus Analysis Widget }}
        {{> local_comp_report_ext/ai_commentary_widget }}

        {{#js}}
        require(['jquery', 'local_comp_report_ext/visualizer'], function($, Visualizer) {
            const canvas = document.getElementById('studentClassChart');
            if (canvas) {
                const config = JSON.parse(canvas.getAttribute('data-chart-config'));
                Visualizer.initStudentClass(config);
            }

            $('#btn-export-student-class-excel').on('click', function() {
                var rows = [];
                rows.push(['"{{#str}}competencyname, local_comp_report_ext{{/str}}"', '"{{#str}}courseavg, local_comp_report_ext{{/str}}"', '"{{#str}}classavg, local_comp_report_ext{{/str}}"', '"{{#str}}myavg, local_comp_report_ext{{/str}}"'].join(','));
                $('#student-class-table tbody tr').each(function() {
                    var cols = [];
                    $(this).find('td').each(function() {
                        var text = $(this).text().replace(/\s+/g, ' ').trim();
                        cols.push('"' + text.replace(/"/g, '""') + '"');
                    });
                    if (cols.length) { rows.push(cols.join(',')); }
                });
                var csvContent = '\uFEFF' + rows.join('\n');
                var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'Student_Class_Comparison_' + new Date().toISOString().slice(0,10) + '.csv';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
        });
        {{/js}}
    {{/has_data}}

    {{^has_data}}
        {{! No Data Alert }}
        <div class="alert alert-info">
            <i class="fa fa-info-circle"></i> {{#str}}nodatafound, local_comp_report_ext{{/str}}
        </div>
    {{/has_data}}
</div>
