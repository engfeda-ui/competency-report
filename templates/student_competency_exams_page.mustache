{{!
    @template local_comp_report_ext/student_competency_exams_page

    Template for displaying student performance report for a specific competency.

    Context variables required for this template:
    * courseid - The ID of the current course.
    * competencyid - The ID of the selected competency.
    * competencies - List of available competencies for selection.
    * has_selection - Boolean indicating if a competency is selected.
    * description - The description of the competency.
    * rows - Array of quiz summary rows.
    * total - Aggregated total performance data.
    * has_questions - Boolean indicating if detailed question links exist.
    * questiondetails - Array of individual question attempts with review URLs.

    Example context (json):
    {
        "courseid": 2,
        "competencyid": 1,
        "has_selection": true,
        "description": "Competency description text.",
        "competencies": [
            {"id": 1, "shortname": "Competency 1", "selected": true}
        ],
        "rows": [
            {"quizname": "Quiz 1", "quizurl": "#", "questions": 5, "correct": 4.5, "rate": 90, "colorclass": "text-success"}
        ],
        "total": {"questions": 5, "correct": 4.5, "rate": 90, "colorclass": "text-success"},
        "has_questions": true,
        "questiondetails": [
            {"quizname": "Quiz 1", "questionname": "Q1", "url": "#"}
        ]
    }
}}
<div class="local_comp_report_ext_competency_exams">
    <!-- Consolidated Student Tab Navigation -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link {{#active_reportcard}}active font-weight-bold{{/active_reportcard}}{{^active_reportcard}}text-muted{{/active_reportcard}}" href="student_report.php?courseid={{courseid}}"><i class="fa fa-vcard-o mr-1"></i> {{#str}}myreportcard, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_examanalysis}}active font-weight-bold{{/active_examanalysis}}{{^active_examanalysis}}text-muted{{/active_examanalysis}}" href="student_exam.php?courseid={{courseid}}"><i class="fa fa-bar-chart mr-1"></i> {{#str}}myexamanalysis, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencyexams}}active font-weight-bold{{/active_competencyexams}}{{^active_competencyexams}}text-muted{{/active_competencyexams}}" href="student_competency_exams.php?courseid={{courseid}}"><i class="fa fa-list-alt mr-1"></i> {{#str}}mycompetencyexams, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencystate}}active font-weight-bold{{/active_competencystate}}{{^active_competencystate}}text-muted{{/active_competencystate}}" href="student_class.php?courseid={{courseid}}"><i class="fa fa-graduation-cap mr-1"></i> {{#str}}mycompetencystate, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_timeline}}active font-weight-bold{{/active_timeline}}{{^active_timeline}}text-muted{{/active_timeline}}" href="timeline.php?courseid={{courseid}}"><i class="fa fa-calendar mr-1"></i> {{#str}}timeline, local_comp_report_ext{{/str}}</a>
        </li>
    </ul>

    {{! 1. Competency Selection Filter }}
    <div class="card mb-4 border-0 shadow-sm bg-light">
        <div class="card-body">
            <form method="get" id="competency_filter_form">
                <input type="hidden" name="courseid" value="{{courseid}}">
                <div class="form-row align-items-end">
                    <div class="col-12 col-md-9 mb-3 mb-md-0">
                        <label class="font-weight-bold" for="id_competency_select">{{#str}}selectcompetency, local_comp_report_ext{{/str}}</label>
                        <select name="competencyid" id="id_competency_select" class="form-control">
                            <option value="0">{{#str}}selectcompetency, local_comp_report_ext{{/str}}</option>
                            {{#competencies}}
                                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{shortname}}</option>
                            {{/competencies}}
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fa fa-search"></i> {{#str}}show, local_comp_report_ext{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {{#has_selection}}
        {{#description}}
        <div class="alert alert-info border-left-info shadow-sm mb-4">
            <i class="fa fa-info-circle"></i> {{{description}}}
        </div>
        {{/description}}

        {{! 2. Summary Table }}
        {{#rows.0}}
        <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
            <h4 class="mb-0">{{#str}}summaryreport, local_comp_report_ext{{/str}}</h4>
            <div>
                <button type="button" class="btn btn-outline-secondary btn-sm mr-2" onclick="window.print()">
                    <i class="fa fa-print mr-1"></i> {{#str}}print, core{{/str}}
                </button>
                <button type="button" id="btn-export-comp-exams-excel" class="btn btn-outline-success btn-sm">
                    <i class="fa fa-file-excel-o mr-1"></i> {{#str}}exportexcel, local_comp_report_ext{{/str}}
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="comp-exams-summary-table" class="generaltable table table-hover shadow-sm bg-white">
                <thead class="thead-dark">
                    <tr>
                        <th>{{#str}}quiz, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}question, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}correct, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}success, local_comp_report_ext{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <td>
                            <a href="{{quizurl}}" target="_blank"><strong>{{quizname}}</strong></a>
                        </td>
                        <td class="text-center">{{questions}}</td>
                        <td class="text-center">{{correct}}</td>
                        <td class="text-center font-weight-bold {{colorclass}}">%{{rate}}</td>
                    </tr>
                    {{/rows}}
                </tbody>
                {{#total}}
                <tfoot>
                    <tr class="table-secondary font-weight-bold">
                        <td>{{#str}}total, local_comp_report_ext{{/str}}</td>
                        <td class="text-center">{{questions}}</td>
                        <td class="text-center">{{correct}}</td>
                        <td class="text-center {{colorclass}}">%{{rate}}</td>
                    </tr>
                </tfoot>
                {{/total}}
            </table>
        </div>
        {{/rows.0}}

        {{! 3. Detailed Question Links }}
        {{#has_questions}}
        <h4 class="mt-5">{{#str}}questionlinks, local_comp_report_ext{{/str}}</h4>
        <div class="table-responsive">
            <table class="generaltable table table-bordered table-hover mt-3 shadow-sm bg-white">
                <thead class="thead-light">
                    <tr>
                        <th>{{#str}}quiz, local_comp_report_ext{{/str}}</th>
                        <th>{{#str}}questionname, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}action, local_comp_report_ext{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#questiondetails}}
                    <tr>
                        <td>{{quizname}}</td>
                        <td>{{questionname}}</td>
                        <td class="text-center">
                            <a href="{{url}}" class="btn btn-sm btn-outline-primary view-question-modal">
                                <i class="fa fa-search"></i> {{#str}}viewattempt, local_comp_report_ext{{/str}}
                            </a>
                        </td>
                    </tr>
                    {{/questiondetails}}
                </tbody>
            </table>
        </div>
        {{/has_questions}}

        {{^rows}}
            <div class="alert alert-warning shadow-sm">
                <i class="fa fa-exclamation-triangle"></i> {{#str}}nocompetencyexamdata, local_comp_report_ext{{/str}}
            </div>
        {{/rows}}

        {{! Reusable AI Commentary & Focus Analysis Widget }}
        {{> local_comp_report_ext/ai_commentary_widget }}
    {{/has_selection}}
</div>

{{#js}}
require(['jquery', 'core/form-autocomplete', 'local_comp_report_ext/modal_viewer'], function($, Autocomplete, ModalViewer) {
    Autocomplete.enhance('#id_competency_select', false, false, "{{#str}}selectcompetency, local_comp_report_ext{{/str}}");
    ModalViewer.init('.view-question-modal');

    $('#btn-export-comp-exams-excel').on('click', function() {
        var rows = [];
        rows.push(['"{{#str}}quiz, local_comp_report_ext{{/str}}"', '"{{#str}}question, local_comp_report_ext{{/str}}"', '"{{#str}}correct, local_comp_report_ext{{/str}}"', '"{{#str}}success, local_comp_report_ext{{/str}}"'].join(','));
        $('#comp-exams-summary-table tbody tr, #comp-exams-summary-table tfoot tr').each(function() {
            var cols = [];
            $(this).find('td').each(function() {
                var text = $(this).text().replace(/\s+/g, ' ').trim();
                cols.push('"' + text.replace(/"/g, '""') + '"');
            });
            if (cols.length) { rows.push(cols.join(',')); }
        });
        var csvContent = '\uFEFF' + rows.join('\n');
        var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Competency_Quizzes_Summary_' + new Date().toISOString().slice(0,10) + '.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
});
{{/js}}
