{{!
    AI progress bar snippet template.
    @package local_comp_report_ext
}}
<div class="ai-progress-item my-1">
    <strong>{{name}} ({{percent}}%)</strong>
    <table border="0" cellspacing="0" cellpadding="0" width="150" height="8" style="border: 1px solid #dee2e6; margin-top: 2px;">
        <tr>
            {{#has_width}}<td bgcolor="{{color}}" width="{{width}}%">&nbsp;</td>{{/has_width}}
            {{#has_remaining}}<td bgcolor="#e9ecef" width="{{remaining}}%">&nbsp;</td>{{/has_remaining}}
        </tr>
    </table>
</div>
