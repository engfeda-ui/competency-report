    @template local_competency_report/class_report_page

    Example context (json):
    {
        "pdf_url": "#",
        "form_html": "<form><select class='custom-select'><option>Grup SeÃ§in</option></select></form>",
        "has_data": true,
        "rows": [
            {
                "shortname": "Y01",
                "courserate": "75",
                "classrate": "68",
                "studentrate": "82"
            }
        ],
        "chart_config": "{\"labels\":[\"Y01\"],\"datasets\":[]}"
    }
}}
<div class="local_competency_report_class_report">

    {{! 1. Top Buttons and Links }}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button id="btn-export-class-pdf-top" class="btn btn-secondary">
            <i class="fa fa-file-pdf-o"></i> {{#str}}pdfreport, local_competency_report{{/str}}
        </button>
    </div>

    {{! 2. Selector Form Area }}
    <div class="card mb-4 p-3 bg-light border-0 shadow-sm">
        <div class="card-body">
            {{{form_html}}}
        </div>
    </div>

    {{#has_data}}
        {{! 3. Report Table }}
        <div class="table-responsive">
            <table class="generaltable table table-bordered table-hover mt-4 shadow-sm bg-white">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col">{{#str}}competencyname, local_competency_report{{/str}}</th>
                        <th scope="col" class="text-center">{{#str}}courseavg, local_competency_report{{/str}}</th>
                        <th scope="col" class="text-center">{{#str}}classavg, local_competency_report{{/str}}</th>
                        <th scope="col" class="text-center">{{#str}}studentavg, local_competency_report{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <td><strong>{{shortname}}</strong></td>
                        <td class="text-center font-weight-bold text-dark">%{{courserate}}</td>
                        <td class="text-center text-muted">%{{classrate}}</td>
                        <td class="text-center text-primary font-weight-bold">%{{studentrate}}</td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>

        {{! 4. Chart Area }}
        <div class="card mt-4 p-4 shadow-sm bg-white border-0">
            <div class="card-title">
                <h5><i class="fa fa-bar-chart"></i> {{#str}}visual_report, local_competency_report{{/str}}</h5>
            </div>
            <div style="height:400px; width:100%; position: relative;">
                {{! Store configuration data safely in data-chart-config }}
                <canvas id="studentClassChart" data-chart-config="{{chart_config}}"></canvas>
            </div>
        </div>

        {{! Reusable AI Commentary & Focus Analysis Widget }}
        {{> local_competency_report/ai_commentary_widget }}
    {{/has_data}}

    {{^has_data}}
        {{! No Data Found Warning }}
        <div class="alert alert-info shadow-sm">
            <i class="fa fa-info-circle"></i> {{#str}}nodatafound, local_competency_report{{/str}}
        </div>
    {{/has_data}}
</div>

{{#has_data}}
{{#js}}
require(['local_competency_report/visualizer', 'core/log', 'jquery'], function(Visualizer, Log, $) {
    const canvas = document.getElementById('studentClassChart');
    if (canvas) {
        const rawData = canvas.getAttribute('data-chart-config');
        try {
            const params = JSON.parse(rawData);
            Visualizer.initStudentClass(params);
        } catch (e) {
            Log.error("An error occurred while loading the Competency Chart");
            Log.error(e);
        }
    }

    $('#btn-export-class-pdf-top').on('click', function(e) {
        e.preventDefault();
        var editedHtml = '';
        var aiContent = $('.ai-content-html');
        if (aiContent.length && aiContent.html().trim() !== '') {
            editedHtml = aiContent.html();
        }
        
        var userid = parseInt("{{userid}}") || 0;
        var targetUrl = (userid > 0) 
            ? M.cfg.wwwroot + '/local/competency_report/parent_pdf.php' 
            : M.cfg.wwwroot + '/local/competency_report/school_pdf.php';

        var form = $('<form>', {
            action: targetUrl,
            method: 'POST',
            target: '_blank'
        });

        var params = {
            courseid: "{{courseid}}",
            pdf_content: editedHtml
        };
        if (userid > 0) {
            params.userid = userid;
        }

        $.each(params, function(key, val) {
            form.append($('<input>', {
                type: 'hidden',
                name: key,
                value: val
            }));
        });

        $('body').append(form);
        form.submit();
        form.remove();
    });
});
{{/js}}
{{/has_data}}
