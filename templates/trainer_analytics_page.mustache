<div class="local_comp_report_ext_trainer_analytics">
    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_competency.php?courseid={{courseid}}">
                <i class="fa fa-list-alt mr-1"></i> {{#str}}tab_by_competency, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_quiz_competency.php?courseid={{courseid}}">
                <i class="fa fa-pencil-square-o mr-1"></i> {{#str}}tab_by_quiz, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_assessment_distribution.php?courseid={{courseid}}">
                <i class="fa fa-balance-scale mr-1"></i> {{#str}}tab_assessment_distribution, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_analytics_dashboard.php?courseid={{courseid}}">
                <i class="fa fa-bar-chart mr-1"></i> {{#str}}tab_analytics_competency, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_exam_analytics.php?courseid={{courseid}}">
                <i class="fa fa-line-chart mr-1"></i> {{#str}}tab_analytics_grades, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="term_comprehensive_report.php?courseid={{courseid}}">
                <i class="fa fa-graduation-cap mr-1"></i> {{#str}}tab_term_comprehensive, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active font-weight-bold" href="#">
                <i class="fa fa-user-circle-o mr-1"></i> {{#str}}tab_trainer_analytics, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="institutional_dashboard.php?courseid={{courseid}}">
                <i class="fa fa-university mr-1"></i> {{#str}}tab_institutional_dashboard, local_comp_report_ext{{/str}}
            </a>
        </li>
    </ul>

    <!-- Filter Form -->
    <form method="get" class="form-inline mb-4 bg-light p-3 rounded shadow-sm d-flex justify-content-between align-items-center flex-wrap">
        <div class="d-flex align-items-center mb-2 mb-sm-0 flex-wrap">
            <div class="form-group mr-3 mb-2 mb-sm-0">
                <label class="font-weight-bold mr-2 mb-0"><i class="fa fa-book mr-1 text-primary"></i> {{#str}}filter_by_course, local_comp_report_ext{{/str}}</label>
                <select name="courseid" class="form-control form-control-sm font-weight-bold" onchange="this.form.submit()">
                    {{#course_options}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/course_options}}
                </select>
            </div>

            {{^is_all_courses}}
            <div class="form-group mr-3 mb-2 mb-sm-0">
                <label class="font-weight-bold mr-2 mb-0"><i class="fa fa-users mr-1"></i> {{#str}}group, local_comp_report_ext{{/str}}</label>
                <select name="groupid" class="form-control form-control-sm" onchange="this.form.submit()">
                    {{#groups}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/groups}}
                </select>
            </div>
            {{/is_all_courses}}
            <button type="submit" class="btn btn-primary btn-sm mb-2 mb-sm-0"><i class="fa fa-eye mr-1"></i> {{strshowstudents}}</button>
        </div>

        {{#has_data}}
        <button id="btn-print-trainers" type="button" class="btn btn-outline-secondary btn-sm font-weight-bold">
            <i class="fa fa-print mr-1"></i> {{strprintreport}}
        </button>
        {{/has_data}}
    </form>

    {{^has_data}}
        <div class="alert alert-info py-5 text-center shadow-sm">
            <i class="fa fa-user-circle-o fa-3x mb-3 opacity-50 d-block"></i>
            <p class="mb-0">{{strnotrainers}}</p>
        </div>
    {{/has_data}}

    {{#has_data}}
    <div id="trainer-analytics-content">
        <!-- Trainer Performance Horizontal Comparison Bars -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white font-weight-bold border-bottom py-3 d-flex align-items-center">
                <i class="fa fa-trophy text-warning mr-2 fa-lg"></i>
                <span class="text-navy font-weight-bold">Trainer Mastery & Performance Benchmarking</span>
                <span class="badge badge-info ml-2">{{trainer_count}} Trainers</span>
            </div>
            <div class="card-body p-4">
                <div style="position: relative; min-height: 250px; width: 100%;">
                    <canvas id="trainerComparisonChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Comparative Trainer Analytics Master Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="fa fa-list-alt text-primary mr-2 fa-lg"></i>
                    <h5 class="mb-0 font-weight-bold text-navy">Comparative Trainer Performance Roster</h5>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0 text-center small align-middle">
                        <thead class="bg-light text-uppercase font-weight-bold text-navy">
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th class="text-left" style="min-width: 180px;">{{#str}}trainer_name, local_comp_report_ext{{/str}}</th>
                                {{#is_all_courses}}
                                <th style="min-width: 150px;">{{#str}}specializations_taught, local_comp_report_ext{{/str}}</th>
                                {{/is_all_courses}}
                                <th>{{#str}}trainer_cohort_count, local_comp_report_ext{{/str}}</th>
                                <th>Practical Evaluated</th>
                                <th class="bg-info-light text-info font-weight-bold">{{#str}}trainer_avg_mastery, local_comp_report_ext{{/str}}</th>
                                <th class="bg-success-light text-success font-weight-bold">{{#str}}trainer_pass_rate, local_comp_report_ext{{/str}}</th>
                                <th class="text-left bg-light">{{#str}}trainer_top_comp, local_comp_report_ext{{/str}}</th>
                                <th class="text-left bg-light">{{#str}}trainer_weak_comp, local_comp_report_ext{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#trainer_list}}
                            <tr>
                                <td class="font-weight-bold text-muted">{{index}}</td>
                                <td class="text-left font-weight-bold">
                                    <i class="fa fa-user-circle text-muted mr-1"></i> {{fullname}}
                                    <small class="d-block text-muted">{{email}}</small>
                                </td>
                                {{#is_all_courses}}
                                <td>
                                    <span class="badge badge-info mb-1">{{specs_count}} {{#str}}specializations_count, local_comp_report_ext{{/str}}</span>
                                    <small class="d-block text-muted font-weight-bold">{{specs_display}}</small>
                                </td>
                                {{/is_all_courses}}
                                <td>
                                    <span class="badge badge-light border px-2 py-1 font-weight-bold">{{student_count}}</span>
                                </td>
                                <td>
                                    <span class="badge badge-light border px-2 py-1">{{evaluations_count}} entries</span>
                                </td>
                                <td>
                                    <span class="badge {{badge}} px-2 py-1 font-weight-bold" style="font-size: 13px;">
                                        {{avg_mastery}}%
                                    </span>
                                </td>
                                <td>
                                    <span class="font-weight-bold text-success" style="font-size: 13px;">
                                        {{pass_rate}}%
                                    </span>
                                </td>
                                <td class="text-left text-success font-weight-bold">
                                    <i class="fa fa-arrow-up mr-1 text-success small"></i> {{top_comp}}
                                </td>
                                <td class="text-left text-danger font-weight-bold">
                                    <i class="fa fa-arrow-down mr-1 text-danger small"></i> {{weak_comp}}
                                </td>
                            </tr>
                            {{/trainer_list}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {{/has_data}}
</div>

<style>
.local_comp_report_ext_trainer_analytics .bg-info-light { background-color: #e1f5fe !important; }
.local_comp_report_ext_trainer_analytics .bg-success-light { background-color: #e8f5e9 !important; }
.local_comp_report_ext_trainer_analytics .text-navy { color: #16324f !important; }

@media print {
    .nav-tabs, form, #btn-print-trainers { display: none !important; }
    body { background: #fff !important; }
    .card { border: none !important; box-shadow: none !important; }
}
</style>

{{#has_data}}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var ctx = document.getElementById('trainerComparisonChart');
    if (ctx && typeof Chart !== 'undefined') {
        var names = {{{trainer_names_json}}};
        var masteries = {{{trainer_mastery_json}}};
        var passrates = {{{trainer_pass_json}}};

        new Chart(ctx, {
            type: 'horizontalBar',
            data: {
                labels: names,
                datasets: [
                    {
                        label: 'Avg Mastery (%)',
                        data: masteries,
                        backgroundColor: '#007bff',
                        borderRadius: 4
                    },
                    {
                        label: 'Pass Rate (%)',
                        data: passrates,
                        backgroundColor: '#28a745',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    xAxes: [{
                        ticks: { beginAtZero: true, max: 100 }
                    }]
                }
            }
        });
    }

    var btnPrint = document.getElementById('btn-print-trainers');
    if (btnPrint) {
        btnPrint.addEventListener('click', function() {
            window.print();
        });
    }
});
</script>
{{/has_data}}
