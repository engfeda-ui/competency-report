<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Render GPA Distribution Chart using Chart.js.
    var ctx = document.getElementById('termGpaChart');
    if (ctx && typeof Chart !== 'undefined') {
        var labels = {{{gpa_labels_json}}};
        var counts = {{{gpa_counts_json}}};
        var colors = ['#28a745', '#28a745', '#17a2b8', '#17a2b8', '#ffc107', '#ffc107', '#007bff', '#6c757d', '#dc3545'];

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Students Count',
                    data: counts,
                    backgroundColor: colors,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: { display: false },
                scales: {
                    yAxes: [{
                        ticks: { beginAtZero: true, precision: 0 }
                    }]
                }
            }
        });
    }

    // 2. Search & Filter in Student Table.
    var searchInput = document.getElementById('term-search-input');
    var filterStatus = document.getElementById('term-filter-status');
    var rows = document.querySelectorAll('.student-term-row');

    function filterTable() {
        var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var status = filterStatus ? filterStatus.value : 'all';

        rows.forEach(function(row) {
            var text = row.textContent.toLowerCase();
            var matchesQuery = !query || text.indexOf(query) !== -1;
            var isPassed = row.getAttribute('data-passed') === '1';
            var hasRetake = row.getAttribute('data-retake') === '1';

            var matchesStatus = true;
            if (status === 'passed') {
                matchesStatus = isPassed;
            } else if (status === 'failed') {
                matchesStatus = !isPassed;
            } else if (status === 'retake') {
                matchesStatus = hasRetake;
            }

            row.style.display = (matchesQuery && matchesStatus) ? '' : 'none';
        });
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (filterStatus) filterStatus.addEventListener('change', filterTable);

    // 3. Print Action.
    var btnPrint = document.getElementById('btn-print-term');
    if (btnPrint) {
        btnPrint.addEventListener('click', function() {
            window.print();
        });
    }

    // 4. Excel Export Action (CSV download).
    var btnExcel = document.getElementById('btn-export-excel');
    if (btnExcel) {
        btnExcel.addEventListener('click', function() {
            var studentData = {{{student_list_json}}};
            if (!studentData || !studentData.length) return;

            var csvContent = "\uFEFF"; // UTF-8 BOM
            csvContent += "#,Student Name,Academic ID,Email,Theory Final (/30),Retake 1 Theory,Retake 2 Theory,Best Theory (/30),Theory Status,Practical (/40),Retake 1 Practical,Retake 2 Practical,Best Practical (/40),Practical Status,Participation (/20),Assignments (/10),Term Total (/100),Letter Grade,GPA,Overall Status\n";

            studentData.forEach(function(s) {
                var row = [
                    s.index,
                    '"' + s.fullname.replace(/"/g, '""') + '"',
                    '"' + (s.idnumber || '').replace(/"/g, '""') + '"',
                    '"' + s.email + '"',
                    s.theory_final_30,
                    s.retake1_t,
                    s.retake2_t,
                    s.best_theory,
                    s.theory_pass ? 'Passed' : 'Failed',
                    s.prac_orig_40,
                    s.retake1_p,
                    s.retake2_p,
                    s.best_practical,
                    s.practical_pass ? 'Passed' : (s.has_practical ? 'Failed' : 'None'),
                    s.participation,
                    s.assignments,
                    s.term_total,
                    s.gpa_letter,
                    s.gpa_value,
                    s.overall_pass ? 'Passed' : 'Failed'
                ];
                csvContent += row.join(',') + "\n";
            });

            var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'term_comprehensive_report_course_' + '{{courseid}}' + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        });
    }
});
</script>
{{/has_data}}
