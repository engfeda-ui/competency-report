    @template local_competency_report/school_report

    Example context (json):
    {
        "has_data": true,
        "ai_comment": {
            "title": "Yapay Zeka Analizi",
            "content": "<p>Genel baÅŸarÄ± oranÄ± %75'in Ã¼zerindedir.</p>"
        },
        "rows": [
            {
                "shortname": "MAT01",
                "description": "Temel Matematik YetkinliÄŸi",
                "attempts": 150,
                "correct": 120,
                "rate": "80",
                "rowclass": ""
            }
        ],
        "pdf_url": "#"
    }
}}
<div class="local_competency_report_school_report">

    {{#has_data}}
        {{! Reusable AI Commentary & Focus Analysis Widget }}
        {{> local_competency_report/ai_commentary_widget }}

        {{! BaÅŸarÄ± Tablosu }}
        <div class="table-responsive shadow-sm">
            <table class="generaltable table table-hover bg-white mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>{{#str}}competencycode, local_competency_report{{/str}}</th>
                        <th>{{#str}}competencyname, local_competency_report{{/str}}</th>
                        <th class="text-center">{{#str}}questioncount, local_competency_report{{/str}}</th>
                        <th class="text-center">{{#str}}correctcount, local_competency_report{{/str}}</th>
                        <th class="text-center">{{#str}}successrate, local_competency_report{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr class="{{rowclass}}">
                        <td><strong>{{shortname}}</strong></td>
                        <td>{{{description}}}</td>
                        <td class="text-center">{{attempts}}</td>
                        <td class="text-center">{{correct}}</td>
                        <td class="text-center"><strong>%{{rate}}</strong></td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <a href="{{pdf_url}}" class="btn btn-outline-danger shadow-sm px-4">
                <i class="fa fa-file-pdf-o"></i> {{#str}}schoolpdf, local_competency_report{{/str}}
            </a>
        </div>
    {{/has_data}}

    {{^has_data}}
        <div class="alert alert-info">
            <i class="fa fa-info-circle"></i> {{#str}}nodatafound, local_competency_report{{/str}}
        </div>
    {{/has_data}}

</div>
