<div class="local_comp_report_ext_institutional_dashboard pb-5">

    <!-- Header & Action Controls -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border">
        <div>
            <h3 class="font-weight-bold text-dark mb-1">
                <i class="fa fa-university text-primary mr-2"></i> {{#str}}institutional_dashboard_title, local_comp_report_ext{{/str}}
            </h3>
            <p class="text-muted mb-0 small">
                {{#str}}courses_overview_title, local_comp_report_ext{{/str}}
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center mt-2 mt-md-0">
            <!-- Category Filter Form -->
            <form method="get" action="" class="form-inline mr-2 mb-2 mb-md-0">
                <div class="input-group input-group-sm">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-light"><i class="fa fa-folder-open text-muted mr-1"></i> {{#str}}filter_by_category, local_comp_report_ext{{/str}}</span>
                    </div>
                    <select name="categoryid" class="custom-select custom-select-sm" onchange="this.form.submit()">
                        {{#categories}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/categories}}
                    </select>
                </div>
            </form>

            {{#has_data}}
            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm shadow-sm" role="group">
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="fa fa-print mr-1"></i> {{#str}}print, core{{/str}}
                </button>
                <button type="button" id="btn-export-csv" class="btn btn-outline-success">
                    <i class="fa fa-file-excel-o mr-1"></i> {{#str}}export_csv, local_comp_report_ext{{/str}}
                </button>
                <a href="{{pdf_url}}" class="btn btn-outline-danger">
                    <i class="fa fa-file-pdf-o mr-1"></i> {{#str}}pdfreport, local_comp_report_ext{{/str}}
                </a>
            </div>
            {{/has_data}}
        </div>
    </div>

    {{#has_data}}
    <!-- 1. Executive KPI Summary Cards -->
    <div class="row mb-4">
        <!-- Evaluated Courses -->
        <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden h-100" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small font-weight-bold opacity-75 mb-1">{{#str}}active_courses_count, local_comp_report_ext{{/str}}</div>
                        <div class="h2 font-weight-bold mb-0">{{total_courses}}</div>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="fa fa-book fa-2x text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Evaluated Students -->
        <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden h-100" style="background: linear-gradient(135deg, #4c1d95 0%, #8b5cf6 100%); color: white;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small font-weight-bold opacity-75 mb-1">{{#str}}total_evaluated_students, local_comp_report_ext{{/str}}</div>
                        <div class="h2 font-weight-bold mb-0">{{total_students}}</div>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="fa fa-users fa-2x text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Overall Institution Mastery -->
        <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden h-100" style="background: linear-gradient(135deg, #065f46 0%, #10b981 100%); color: white;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small font-weight-bold opacity-75 mb-1">{{#str}}overall_institution_mastery, local_comp_report_ext{{/str}}</div>
                        <div class="h2 font-weight-bold mb-0">%{{overall_mastery}}</div>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="fa fa-line-chart fa-2x text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assessed Competencies -->
        <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden h-100" style="background: linear-gradient(135deg, #9a3412 0%, #f97316 100%); color: white;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small font-weight-bold opacity-75 mb-1">{{#str}}total_assessed_competencies, local_comp_report_ext{{/str}}</div>
                        <div class="h2 font-weight-bold mb-0">{{total_competencies}}</div>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="fa fa-check-circle fa-2x text-white"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Visual Analytics Charts -->
    <div class="row mb-4">
        <!-- Course Comparison Bar Chart -->
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm rounded-lg h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <h5 class="font-weight-bold text-dark mb-0">
                        <i class="fa fa-bar-chart text-primary mr-2"></i> {{#str}}course_comparison_chart, local_comp_report_ext{{/str}}
                    </h5>
                    <span class="badge badge-light border text-muted px-2 py-1 font-weight-normal">% {{#str}}overall_mastery, local_comp_report_ext{{/str}}</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 320px; width: 100%;">
                        <canvas id="chart-courses-comparison"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mastery Level Distribution Doughnut Chart -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-lg h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="font-weight-bold text-dark mb-0">
                        <i class="fa fa-pie-chart text-info mr-2"></i> {{#str}}mastery_distribution_chart, local_comp_report_ext{{/str}}
                    </h5>
                </div>
                <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="chart-mastery-distribution"></canvas>
                    </div>
                    <div class="d-flex justify-content-around w-100 mt-2 small text-center text-muted">
                        <div><i class="fa fa-circle text-success mr-1"></i> {{#str}}tier_high_mastery, local_comp_report_ext{{/str}}</div>
                        <div><i class="fa fa-circle text-info mr-1"></i> {{#str}}tier_moderate_mastery, local_comp_report_ext{{/str}}</div>
                        <div><i class="fa fa-circle text-danger mr-1"></i> {{#str}}tier_needs_focus, local_comp_report_ext{{/str}}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Focus Competencies (Strengths & Attention Areas) -->
    <div class="row mb-4">
        <!-- Top 5 Achieving Competencies -->
        {{#has_top_competencies}}
        <div class="col-md-6 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm rounded-lg h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center">
                    <span class="badge badge-success mr-2 p-2"><i class="fa fa-arrow-up"></i></span>
                    <h5 class="font-weight-bold text-dark mb-0">{{#str}}top_strengths_title, local_comp_report_ext{{/str}}</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {{#top_competencies}}
                        <li class="list-group-item p-3 border-bottom d-flex justify-content-between align-items-center">
                            <div class="pr-2" style="flex: 1;">
                                <div class="font-weight-bold text-dark mb-1">{{shortname}}</div>
                                <div class="text-muted small text-truncate" style="max-width: 380px;">{{description}}</div>
                                <div class="progress mt-2" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: {{rate}}%"></div>
                                </div>
                            </div>
                            <span class="badge badge-pill badge-success font-weight-bold px-3 py-2 text-white">%{{rate_str}}</span>
                        </li>
                        {{/top_competencies}}
                    </ul>
                </div>
            </div>
        </div>
        {{/has_top_competencies}}

        <!-- Lowest 5 Competencies Needing Support -->
        {{#has_lowest_competencies}}
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-lg h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center">
                    <span class="badge badge-danger mr-2 p-2"><i class="fa fa-arrow-down"></i></span>
                    <h5 class="font-weight-bold text-dark mb-0">{{#str}}lowest_competencies_title, local_comp_report_ext{{/str}}</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {{#lowest_competencies}}
                        <li class="list-group-item p-3 border-bottom d-flex justify-content-between align-items-center">
                            <div class="pr-2" style="flex: 1;">
                                <div class="font-weight-bold text-dark mb-1">{{shortname}}</div>
                                <div class="text-muted small text-truncate" style="max-width: 380px;">{{description}}</div>
                                <div class="progress mt-2" style="height: 6px;">
                                    <div class="progress-bar bg-danger" role="progressbar" style="width: {{rate}}%"></div>
                                </div>
                            </div>
                            <span class="badge badge-pill badge-danger font-weight-bold px-3 py-2 text-white">%{{rate_str}}</span>
                        </li>
                        {{/lowest_competencies}}
                    </ul>
                </div>
            </div>
        </div>
        {{/has_lowest_competencies}}
    </div>

    <!-- 4. Active Courses Breakdown Master Table -->
    <div class="card border-0 shadow-sm rounded-lg">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center">
            <h5 class="font-weight-bold text-dark mb-2 mb-md-0">
                <i class="fa fa-list-alt text-primary mr-2"></i> {{#str}}courses_overview_title, local_comp_report_ext{{/str}}
            </h5>
            <div class="input-group input-group-sm" style="max-width: 300px;">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-light"><i class="fa fa-search text-muted"></i></span>
                </div>
                <input type="text" id="course-search-input" class="form-control" placeholder="{{#str}}search_courses_placeholder, local_comp_report_ext{{/str}}">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="courses-master-table">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="py-3 px-3 border-0">#</th>
                        <th class="py-3 px-3 border-0">{{#str}}course{{/str}}</th>
                        <th class="py-3 px-3 border-0">{{#str}}category{{/str}}</th>
                        <th class="py-3 px-3 border-0 text-center">{{#str}}total_evaluated_students, local_comp_report_ext{{/str}}</th>
                        <th class="py-3 px-3 border-0 text-center">{{#str}}theory_mastery, local_comp_report_ext{{/str}}</th>
                        <th class="py-3 px-3 border-0 text-center">{{#str}}practical_mastery, local_comp_report_ext{{/str}}</th>
                        <th class="py-3 px-3 border-0 text-center">{{#str}}overall_mastery, local_comp_report_ext{{/str}}</th>
                        <th class="py-3 px-3 border-0 text-center">{{#str}}status, local_comp_report_ext{{/str}}</th>
                        <th class="py-3 px-3 border-0 text-right">{{#str}}action, local_comp_report_ext{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                    <tr class="course-row border-bottom">
                        <td class="px-3 font-weight-bold text-muted">{{id}}</td>
                        <td class="px-3">
                            <div class="font-weight-bold text-dark">{{fullname}}</div>
                            <span class="badge badge-light border text-muted small">{{shortname}}</span>
                        </td>
                        <td class="px-3 text-muted small">{{category_name}}</td>
                        <td class="px-3 text-center font-weight-bold text-dark">{{students_count}}</td>
                        <td class="px-3 text-center text-muted">{{theory_rate}}</td>
                        <td class="px-3 text-center text-muted">{{prac_rate}}</td>
                        <td class="px-3 text-center font-weight-bold text-primary">{{overall_rate}}</td>
                        <td class="px-3 text-center">
                            <span class="badge {{badge_class}} px-2 py-1 small">{{status_label}}</span>
                        </td>
                        <td class="px-3 text-right">
                            <a href="{{report_url}}" class="btn btn-sm btn-outline-primary shadow-sm" title="{{#str}}view_course_report, local_comp_report_ext{{/str}}">
                                <i class="fa fa-external-link"></i> {{#str}}view_course_report, local_comp_report_ext{{/str}}
                            </a>
                        </td>
                    </tr>
                    {{/courses}}
                </tbody>
            </table>
        </div>
    </div>
    {{/has_data}}

    {{^has_data}}
    <!-- Empty State -->
    <div class="alert alert-info border-0 shadow-sm p-4 text-center rounded-lg my-4">
        <i class="fa fa-info-circle fa-3x text-info mb-3"></i>
        <h5 class="font-weight-bold">{{#str}}no_active_courses_found, local_comp_report_ext{{/str}}</h5>
        <p class="text-muted mb-0 small">{{#str}}nodatafound, local_comp_report_ext{{/str}}</p>
    </div>
    {{/has_data}}

</div>

{{#has_data}}
{{#js}}
require(['core/chartjs', 'jquery'], function(Chart, $) {
    // 1. Course Comparison Bar Chart
    var ctxComp = document.getElementById('chart-courses-comparison');
    if (ctxComp) {
        var labelsComp = {{{chart_courses_labels_json}}};
        var dataComp   = {{{chart_courses_data_json}}};

        new Chart(ctxComp.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labelsComp,
                datasets: [{
                    label: '{{#str}}overall_mastery, local_comp_report_ext{{/str}} (%)',
                    data: dataComp,
                    backgroundColor: dataComp.map(function(val) {
                        return val >= 80 ? 'rgba(16, 185, 129, 0.75)' : (val >= 60 ? 'rgba(59, 130, 246, 0.75)' : 'rgba(239, 68, 68, 0.75)');
                    }),
                    borderColor: dataComp.map(function(val) {
                        return val >= 80 ? '#10B981' : (val >= 60 ? '#3B82F6' : '#EF4444');
                    }),
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { stepSize: 20 }
                    }
                }
            }
        });
    }

    // 2. Mastery Distribution Donut Chart
    var ctxDist = document.getElementById('chart-mastery-distribution');
    if (ctxDist) {
        var distData = {{{chart_dist_data_json}}};

        new Chart(ctxDist.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: [
                    '{{#str}}tier_high_mastery, local_comp_report_ext{{/str}}',
                    '{{#str}}tier_moderate_mastery, local_comp_report_ext{{/str}}',
                    '{{#str}}tier_needs_focus, local_comp_report_ext{{/str}}'
                ],
                datasets: [{
                    data: distData,
                    backgroundColor: [
                        '#10B981',
                        '#3B82F6',
                        '#EF4444'
                    ],
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                cutout: '70%'
            }
        });
    }

    // 3. Live Table Search Filter
    $('#course-search-input').on('keyup', function() {
        var query = $(this).val().toLowerCase();
        $('#courses-master-table tbody tr.course-row').each(function() {
            var text = $(this).text().toLowerCase();
            $(this).toggle(text.indexOf(query) > -1);
        });
    });

    // 4. CSV Table Export
    $('#btn-export-csv').on('click', function() {
        var rows = [];
        var headers = ['Course ID', 'Course Name', 'Short Name', 'Category', 'Evaluated Students', 'Theory Mastery', 'Practical Mastery', 'Overall Mastery', 'Status'];
        rows.push(headers.join(','));

        $('#courses-master-table tbody tr.course-row').each(function() {
            var cols = [];
            $(this).find('td').each(function(index) {
                if (index < 8) { // Exclude actions button column
                    var text = $(this).text().replace(/\s+/g, ' ').trim();
                    cols.push('"' + text.replace(/"/g, '""') + '"');
                }
            });
            if (cols.length > 0) {
                rows.push(cols.join(','));
            }
        });

        var csvContent = '\uFEFF' + rows.join('\n');
        var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.setAttribute('href', url);
        link.setAttribute('download', 'Institutional_Competency_Report_' + new Date().toISOString().slice(0,10) + '.csv');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
});
{{/js}}
{{/has_data}}
