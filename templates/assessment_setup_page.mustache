{{!
    Assessment Setup Page — configure quiz/practical assessments and their weights.
    @package local_competency_report
}}
<div class="local-competency-assessment-setup">

    {{#strweightwarning}}
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
        <i class="fa fa-exclamation-triangle"></i>
        <span>{{strweightwarning}}</span>
    </div>
    {{/strweightwarning}}

    {{#weightok}}
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <i class="fa fa-check-circle"></i>
        <span>{{#str}}weighttotal_ok, local_competency_report{{/str}}</span>
    </div>
    {{/weightok}}

    {{! ─── Saved Assessments Table ─── }}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fa fa-list-check me-2"></i>{{#str}}configuredassessments, local_competency_report{{/str}}</h5>
            <span class="badge bg-light text-dark">{{#str}}totalweightlabel, local_competency_report{{/str}}: {{totalweight}}%</span>
        </div>
        <div class="card-body p-0">
            {{#hasassessments}}
            <form method="post" action="{{formaction}}">
                <input type="hidden" name="action" value="update_existing">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>{{strname}}</th>
                                <th>{{strtype}}</th>
                                <th>{{strquiz}} / {{#str}}pluginname, mod_assign{{/str}}</th>
                                <th class="text-end" style="max-width: 150px;">{{strweight}} (%)</th>
                                <th class="text-center" style="width: 80px;">{{strdelete}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#assessments}}
                            <tr>
                                <td>
                                    <input type="text" name="name[{{id}}]" value="{{name}}" class="form-control form-control-sm fw-bold" required>
                                </td>
                                <td>
                                    {{#type}}
                                    <span class="badge {{#type}}{{.}}{{/type}}-badge">
                                        {{typelabel}}
                                    </span>
                                    {{/type}}
                                </td>
                                <td class="text-muted small"><strong>{{associatedactivity}}</strong></td>
                                <td class="text-end" style="max-width: 150px;">
                                    <div class="input-group input-group-sm justify-content-end ms-auto" style="max-width: 120px;">
                                        <input type="number" name="weight[{{id}}]" value="{{weight}}" class="form-control text-end text-primary fw-bold" min="0" max="100" step="0.1" required>
                                        <span class="input-group-text">%</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a href="{{deleteurl}}"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('{{#str}}confirmdelete, local_competency_report{{/str}}');">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                            {{/assessments}}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-light text-end p-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i> {{#str}}updateassessments, local_competency_report{{/str}}
                    </button>
                </div>
            </form>
            {{/hasassessments}}
            {{^hasassessments}}
            <div class="text-center py-5 text-muted">
                <i class="fa fa-inbox fa-3x mb-3 d-block opacity-50"></i>
                <p>{{#str}}noassessments, local_competency_report{{/str}}</p>
            </div>
            {{/hasassessments}}
        </div>
    </div>

    {{! ─── Add New Assessment Form ─── }}
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="fa fa-plus-circle me-2"></i>{{#str}}addnewassessment, local_competency_report{{/str}}</h5>
        </div>
        <div class="card-body">
            <form method="post" action="{{formaction}}" id="assessment-add-form">
                <input type="hidden" name="action" value="add">
                <input type="hidden" name="sesskey" value="{{sesskey}}">

                <div class="row g-3 align-items-end mb-3">
                    {{! Type selector }}
                    <div class="col-md-2">
                        <label for="new_type" class="form-label fw-bold">{{strtype}}</label>
                        <select id="new_type" name="assessment_type" class="form-select" onchange="toggleQuizField(this)">
                            <option value="quiz">{{#str}}typequiz, local_competency_report{{/str}}</option>
                            <option value="practical">{{#str}}typepractical, local_competency_report{{/str}}</option>
                        </select>
                    </div>

                    {{! Name }}
                    <div class="col-md-3">
                        <label for="new_name" class="form-label fw-bold">{{strname}}</label>
                        <input type="text" id="new_name" name="assessment_name"
                               class="form-control"
                               placeholder="{{#str}}assessmentnamepholder, local_competency_report{{/str}}">
                    </div>

                    {{! Quiz selector (shown only for quiz type) }}
                    <div class="col-md-3" id="quiz-selector-wrap">
                        <label for="new_quizid" class="form-label fw-bold">{{strquiz}}</label>
                        <select id="new_quizid" name="assessment_quizid" class="form-select" onchange="autoFillName(this)">
                            <option value="0">— {{#str}}selectquiz, local_competency_report{{/str}} —</option>
                            {{#quizzes}}
                            <option value="{{id}}">{{name}}</option>
                            {{/quizzes}}
                        </select>
                    </div>

                    {{! Assignment selector (shown only for practical type, initially hidden) }}
                    <div class="col-md-3" id="assign-selector-wrap" style="display: none;">
                        <label for="new_assignid" class="form-label fw-bold">{{#str}}pluginname, mod_assign{{/str}}</label>
                        <select id="new_assignid" name="assessment_assignid" class="form-select" onchange="autoFillName(this)">
                            <option value="0">— {{#str}}selectpracticalassessment, local_competency_report{{/str}} —</option>
                            {{#assignments}}
                            <option value="{{id}}">{{name}}</option>
                            {{/assignments}}
                        </select>
                    </div>

                    {{! Weight }}
                    <div class="col-md-2">
                        <label for="new_weight" class="form-label fw-bold">{{strweight}} (%)</label>
                        <input type="number" id="new_weight" name="assessment_weight"
                               class="form-control" min="0" max="100" step="0.5"
                               placeholder="e.g. 40">
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fa fa-plus-circle me-1"></i> {{#str}}addnewassessment, local_competency_report{{/str}}
                        </button>
                    </div>
                </div>

                <div class="alert alert-info small mb-0">
                    <i class="fa fa-info-circle me-1"></i>
                    {{#str}}assessmentweighthint, local_competency_report{{/str}}
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.quiz-badge    { background-color: #0d6efd; color: #fff; }
.practical-badge { background-color: #198754; color: #fff; }
.local-competency-assessment-setup .card { border-radius: 0.75rem; overflow: hidden; }
</style>

<script>
function toggleQuizField(sel) {
    var quizWrap = document.getElementById('quiz-selector-wrap');
    var assignWrap = document.getElementById('assign-selector-wrap');
    if (sel.value === 'practical') {
        quizWrap.style.display = 'none';
        assignWrap.style.display = '';
    } else {
        quizWrap.style.display = '';
        assignWrap.style.display = 'none';
    }
}

function autoFillName(quizSelect) {
    var nameInput = document.getElementById('new_name');
    if (quizSelect.value !== '0' && nameInput.value.trim() === '') {
        var selectedText = quizSelect.options[quizSelect.selectedIndex].text;
        // Strip out the leading dashes if it is the assignment selector
        if (selectedText.startsWith('—')) {
            return;
        }
        nameInput.value = selectedText;
    }
}
</script>
