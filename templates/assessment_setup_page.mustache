{{!
    Assessment Setup Page — configure quiz/practical assessments and their weights.
    @package local_comp_report_ext
}}
<div class="local-competency-assessment-setup">

    {{#strweightwarning}}
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
        <i class="fa fa-exclamation-triangle"></i>
        <span>{{strweightwarning}}</span>
    </div>
    {{/strweightwarning}}

    {{#weightok}}
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <i class="fa fa-check-circle"></i>
        <span>{{#str}}weighttotal_ok, local_comp_report_ext{{/str}}</span>
    </div>
    {{/weightok}}

    {{! ─── Saved Assessments Table ─── }}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fa fa-list-check me-2"></i>{{#str}}configuredassessments, local_comp_report_ext{{/str}}</h5>
            <span class="badge bg-light text-dark">{{#str}}totalweightlabel, local_comp_report_ext{{/str}}: {{totalweight}}%</span>
        </div>
        <div class="card-body p-0">
            {{#hasassessments}}
            <form method="post" action="{{formaction}}">
                <input type="hidden" name="action" value="update">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>{{strname}}</th>
                                <th>{{strtype}}</th>
                                <th>{{strquiz}} / {{#str}}pluginname, mod_assign{{/str}}</th>
                                <th class="text-end" style="max-width: 150px;">{{strweight}}</th>
                                <th class="text-center" style="width: 80px;">{{strdelete}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#assessments}}
                            <tr>
                                <td>
                                    <input type="text" name="name[{{id}}]" value="{{name}}" class="form-control form-control-sm fw-bold" required>
                                </td>
                                <td>
                                    {{#type}}
                                    <span class="badge {{#type}}{{.}}{{/type}}-badge">
                                        {{typelabel}}
                                    </span>
                                    {{/type}}
                                </td>
                                <td class="text-muted small"><strong>{{associatedactivity}}</strong></td>
                                <td class="text-end" style="max-width: 150px;">
                                    <div class="input-group input-group-sm justify-content-end ms-auto" style="max-width: 120px;">
                                        <input type="number" name="weight[{{id}}]" value="{{weight}}" class="form-control text-end text-primary fw-bold" min="0" max="100" step="any" required>
                                        <span class="input-group-text">%</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a href="{{deleteurl}}"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('{{#str}}confirmdelete, local_comp_report_ext{{/str}}');">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                            {{/assessments}}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-light text-end p-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i> {{#str}}updateassessments, local_comp_report_ext{{/str}}
                    </button>
                </div>
            </form>
            {{/hasassessments}}
            {{^hasassessments}}
            <div class="text-center py-5 text-muted">
                <i class="fa fa-inbox fa-3x mb-3 d-block opacity-50"></i>
                <p>{{#str}}noassessments, local_comp_report_ext{{/str}}</p>
            </div>
            {{/hasassessments}}
        </div>
    </div>

    {{! ─── Add New Assessment Form ─── }}
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="fa fa-plus-circle me-2"></i>{{#str}}addnewassessment, local_comp_report_ext{{/str}}</h5>
        </div>
        <div class="card-body">
            <form method="post" action="{{formaction}}" id="assessment-add-form">
                <input type="hidden" name="action" value="add">
                <input type="hidden" name="sesskey" value="{{sesskey}}">

                <div class="row g-3 align-items-end mb-3">
                    {{! Type selector }}
                    <div class="col-md-3">
                        <label for="new_type" class="form-label fw-bold">{{strtype}}</label>
                        <select id="new_type" name="assessment_type" class="form-select">
                            <option value="quiz">{{#str}}typequiz, local_comp_report_ext{{/str}}</option>
                            <option value="practical">{{#str}}typepractical, local_comp_report_ext{{/str}}</option>
                            <option value="oral">{{#str}}typeoral, local_comp_report_ext{{/str}}</option>
                            <option value="assign">{{#str}}typeassign, local_comp_report_ext{{/str}}</option>
                        </select>
                    </div>

                    {{! Activity selector (Quizzes and Assignments) }}
                    <div class="col-md-3" id="activity-selector-wrap">
                        <label for="new_activity" class="form-label fw-bold">{{#str}}selectactivity, local_comp_report_ext{{/str}}</label>
                        <select id="new_activity" name="assessment_activity" class="form-select">
                            <option value="0">— {{#str}}selectactivity, local_comp_report_ext{{/str}} —</option>
                            {{#hasquizzes}}
                            <optgroup label="{{#str}}quizzes_group, local_comp_report_ext{{/str}}">
                                {{#quizzes}}
                                <option value="quiz_{{id}}">{{name}}</option>
                                {{/quizzes}}
                            </optgroup>
                            {{/hasquizzes}}
                            {{#hasassignments}}
                            <optgroup label="{{#str}}assignments_group, local_comp_report_ext{{/str}}">
                                {{#assignments}}
                                <option value="assign_{{id}}">{{name}}</option>
                                {{/assignments}}
                            </optgroup>
                            {{/hasassignments}}
                        </select>
                    </div>

                    {{! Name }}
                    <div class="col-md-3">
                        <label for="new_name" class="form-label fw-bold">{{strname}}</label>
                        <input type="text" id="new_name" name="assessment_name"
                               class="form-control"
                               placeholder="{{#str}}assessmentnamepholder, local_comp_report_ext{{/str}}">
                    </div>

                    {{! Weight }}
                    <div class="col-md-1">
                        <label for="new_weight" class="form-label fw-bold">{{strweight}}</label>
                        <input type="number" id="new_weight" name="assessment_weight"
                               class="form-control" min="0" max="100" step="any"
                               placeholder="e.g. 40">
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fa fa-plus-circle me-1"></i> {{#str}}addnewassessment, local_comp_report_ext{{/str}}
                        </button>
                    </div>
                </div>

                <div class="alert alert-info small mb-0">
                    <i class="fa fa-info-circle me-1"></i>
                    {{#str}}assessmentweighthint, local_comp_report_ext{{/str}}
                </div>
            </form>
        </div>
    </div>
</div>

{{#js}}
require(['local_comp_report_ext/assessment_setup'], function(AssessmentSetup) {
    AssessmentSetup.init();
});
{{/js}}
