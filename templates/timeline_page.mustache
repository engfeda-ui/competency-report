    @template local_comp_report_ext/timeline

    Example context (json):
    {
        "courseid": 3,
        "filter_options": [
            { "value": "7", "label": "Last 7 Days", "selected": false },
            { "value": "30", "label": "Last 30 Days", "selected": true }
        ],
        "has_data": true,
        "chart_config": "{\"labels\":[\"Monday\",\"Tuesday\"],\"datasets\":[{\"label\":\"Success Rate\",\"data\":[65,70]}]}"
    }
}}
<div class="local_comp_report_ext_timeline">
    <!-- Consolidated Student Tab Navigation -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link {{#active_reportcard}}active font-weight-bold{{/active_reportcard}}{{^active_reportcard}}text-muted{{/active_reportcard}}" href="student_report.php?courseid={{courseid}}"><i class="fa fa-vcard-o mr-1"></i> {{#str}}myreportcard, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_examanalysis}}active font-weight-bold{{/active_examanalysis}}{{^active_examanalysis}}text-muted{{/active_examanalysis}}" href="student_exam.php?courseid={{courseid}}"><i class="fa fa-bar-chart mr-1"></i> {{#str}}myexamanalysis, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencyexams}}active font-weight-bold{{/active_competencyexams}}{{^active_competencyexams}}text-muted{{/active_competencyexams}}" href="student_competency_exams.php?courseid={{courseid}}"><i class="fa fa-list-alt mr-1"></i> {{#str}}mycompetencyexams, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencystate}}active font-weight-bold{{/active_competencystate}}{{^active_competencystate}}text-muted{{/active_competencystate}}" href="student_class.php?courseid={{courseid}}"><i class="fa fa-graduation-cap mr-1"></i> {{#str}}mycompetencystate, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_timeline}}active font-weight-bold{{/active_timeline}}{{^active_timeline}}text-muted{{/active_timeline}}" href="timeline.php?courseid={{courseid}}"><i class="fa fa-calendar mr-1"></i> {{#str}}timeline, local_comp_report_ext{{/str}}</a>
        </li>
    </ul>

    {{! 1. Filter Selection Card }}
    <div class="card mb-4 border-0 shadow-sm bg-light">
        <div class="card-body">
            <form method="get" class="form-inline">
                <input type="hidden" name="courseid" value="{{courseid}}">

                <label class="mr-2 font-weight-bold" for="days_select">
                    {{#str}}filterlabel, local_comp_report_ext{{/str}}
                </label>

                <select name="days" id="days_select" class="form-control mr-2 custom-select">
                    {{#filter_options}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/filter_options}}
                </select>

                <button type="submit" class="btn btn-primary">
                    {{#str}}show, local_comp_report_ext{{/str}}
                </button>
            </form>
        </div>
    </div>

    {{! 2. Chart Visualization Card }}
    {{#has_data}}
    <div class="card p-4 shadow-sm bg-white border-0">
        <div style="height:450px; width:100%; position: relative;">
            {{! IMPORTANT: The ID must match 'timeline' for visualizer.js integration }}
            <canvas id="timeline" data-chart-config="{{chart_config}}"></canvas>
        </div>
    </div>

    {{! Reusable AI Commentary & Focus Analysis Widget }}
    {{> local_comp_report_ext/ai_commentary_widget }}

    {{#js}}
    require(['local_comp_report_ext/visualizer'], function(Visualizer) {
        const canvas = document.getElementById('timeline');
        if (canvas) {
            // Retrieve and parse JSON configuration for Chart.js.
            const config = JSON.parse(canvas.getAttribute('data-chart-config'));

            // Invoke the initTimeline function within visualizer.js to render the line chart.
            Visualizer.initTimeline(config);
        }
    });
    {{/js}}
    {{/has_data}}

    {{^has_data}}
    {{! 3. Empty State Notification }}
    <div class="alert alert-info border-0 shadow-sm">
        <i class="fa fa-info-circle"></i> {{#str}}nodatafound, local_comp_report_ext{{/str}}
    </div>
    {{/has_data}}

</div>
