    @template local_comp_report_ext/student_report

    Example context (json):
    {
        "has_data": true,
        "rows": [
            {
                "shortname": "C01",
                "description": "Basic Competency Description",
                "questions": 10,
                "correct": 8,
                "rate": "80",
                "color": "#28a745"
            }
        ],
        "pdf_url": "#",
        "ai_comment": "You are showing great progress! Especially in math competency, your success rate has reached 80%."
    }
}}
<div class="local_comp_report_ext_student_report">
    <!-- Consolidated Student Tab Navigation -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link {{#active_reportcard}}active font-weight-bold{{/active_reportcard}}{{^active_reportcard}}text-muted{{/active_reportcard}}" href="student_report.php?courseid={{courseid}}"><i class="fa fa-vcard-o mr-1"></i> {{#str}}myreportcard, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_examanalysis}}active font-weight-bold{{/active_examanalysis}}{{^active_examanalysis}}text-muted{{/active_examanalysis}}" href="student_exam.php?courseid={{courseid}}"><i class="fa fa-bar-chart mr-1"></i> {{#str}}myexamanalysis, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencyexams}}active font-weight-bold{{/active_competencyexams}}{{^active_competencyexams}}text-muted{{/active_competencyexams}}" href="student_competency_exams.php?courseid={{courseid}}"><i class="fa fa-list-alt mr-1"></i> {{#str}}mycompetencyexams, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_competencystate}}active font-weight-bold{{/active_competencystate}}{{^active_competencystate}}text-muted{{/active_competencystate}}" href="student_class.php?courseid={{courseid}}"><i class="fa fa-graduation-cap mr-1"></i> {{#str}}mycompetencystate, local_comp_report_ext{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#active_timeline}}active font-weight-bold{{/active_timeline}}{{^active_timeline}}text-muted{{/active_timeline}}" href="timeline.php?courseid={{courseid}}"><i class="fa fa-calendar mr-1"></i> {{#str}}timeline, local_comp_report_ext{{/str}}</a>
        </li>
    </ul>
    {{#has_data}}
        <!-- Student Premium View Header Banner -->
        <div class="alert alert-info d-flex align-items-center shadow-sm border-0 rounded-lg p-3 mb-4 bg-light text-dark border-left border-info" style="border-left-width: 5px !important;">
            <div class="mr-3 bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; min-width: 48px;">
                <i class="fa fa-graduation-cap fa-lg"></i>
            </div>
            <div>
                <h5 class="mb-1 font-weight-bold text-info">{{#str}}student_banner_title, local_comp_report_ext{{/str}}</h5>
                <p class="mb-0 text-muted small">{{#str}}student_banner_desc, local_comp_report_ext{{/str}}</p>
            </div>
        </div>

        {{! Achievement Statistics Table }}
        <div class="table-responsive">
            <table class="generaltable table table-bordered table-hover mt-3 shadow-sm bg-white">
                <thead class="thead-dark">
                    <tr>
                        <th>{{#str}}competencycode, local_comp_report_ext{{/str}}</th>
                        <th>{{#str}}competency, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}questioncount, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}correctcount, local_comp_report_ext{{/str}}</th>
                        <th class="text-center">{{#str}}successrate, local_comp_report_ext{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <td class="font-weight-bold">{{shortname}}</td>
                        <td>{{{description}}}</td>
                        <td class="text-center">{{questions}}</td>
                        <td class="text-center">{{correct}}</td>
                        <td class="text-center font-weight-bold" style="color: {{color}};">
                            %{{rate}}
                        </td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>

        {{! PDF Report Export Button }}
        <div class="mt-4">
            <button id="btn-export-student-pdf-top" class="btn btn-secondary shadow-sm">
                <i class="fa fa-file-pdf-o"></i> {{#str}}pdfmystudent, local_comp_report_ext{{/str}}
            </button>
        </div>

        {{#has_radar}}
        {{! Radar Gap Analysis Chart — Student vs Class Average }}
        <div class="card border-0 shadow-sm mt-4 mb-4">
            <div class="card-header bg-dark text-white d-flex align-items-center">
                <i class="fa fa-crosshairs mr-2"></i>
                <strong>{{#str}}radar_chart_title, local_comp_report_ext{{/str}}</strong>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">{{#str}}radar_chart_desc, local_comp_report_ext{{/str}}</p>
                <div style="position: relative; max-width: 480px; margin: 0 auto;">
                    <canvas id="competency-radar-chart-{{userid}}" width="480" height="480"></canvas>
                </div>
                <div class="d-flex justify-content-center mt-3 gap-4">
                    <span class="badge badge-pill px-3 py-2" style="background:#007bff; color:white; font-size:0.85rem;">
                        <i class="fa fa-user mr-1"></i> {{#str}}radar_legend_student, local_comp_report_ext{{/str}}
                    </span>
                    <span class="badge badge-pill px-3 py-2 ml-2" style="background:rgba(150,150,150,0.6); color:#333; font-size:0.85rem;">
                        <i class="fa fa-users mr-1"></i> {{#str}}radar_legend_class, local_comp_report_ext{{/str}}
                    </span>
                </div>
            </div>
        </div>
        {{/has_radar}}

        {{! Reusable AI Commentary & Focus Analysis Widget }}
        {{> local_comp_report_ext/ai_commentary_widget }}

{{#js}}
require(['core/chartjs', 'jquery'], function(Chart, $) {
    var rawData = {{{chart_data}}};
    if (!rawData || !rawData.labels || rawData.labels.length < 2) { return; }

    var ctx = document.getElementById('competency-radar-chart-{{userid}}');
    if (!ctx) { return; }

    new Chart(ctx.getContext('2d'), {
        type: 'radar',
        data: {
            labels: rawData.labels,
            datasets: [
                {
                    label: '{{#str}}radar_legend_student, local_comp_report_ext{{/str}}',
                    data: rawData.student,
                    backgroundColor: 'rgba(0, 123, 255, 0.15)',
                    borderColor: '#007bff',
                    borderWidth: 2.5,
                    pointBackgroundColor: '#007bff',
                    pointRadius: 4,
                },
                {
                    label: '{{#str}}radar_legend_class, local_comp_report_ext{{/str}}',
                    data: rawData.class,
                    backgroundColor: 'rgba(150,150,150,0.1)',
                    borderColor: 'rgba(100,100,100,0.5)',
                    borderWidth: 1.5,
                    borderDash: [5, 3],
                    pointBackgroundColor: 'rgba(100,100,100,0.6)',
                    pointRadius: 3,
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                r: {
                    beginAtZero: true,
                    min: 0,
                    max: 100,
                    ticks: {
                        stepSize: 20,
                        callback: function(v) { return v + '%'; },
                        font: { size: 10 }
                    },
                    pointLabels: { font: { size: 11, weight: 'bold' } }
                }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(ctx) { return ctx.dataset.label + ': ' + ctx.raw + '%'; }
                    }
                }
            }
        }
    });

    $('#btn-export-student-pdf-top').on('click', function(e) {
        e.preventDefault();
        var editedHtml = '';
        var aiContent = $('.ai-content-html');
        if (aiContent.length && aiContent.html().trim() !== '') {
            editedHtml = aiContent.html();
        }
        
        var form = $('<form>', {
            action: M.cfg.wwwroot + '/local/competency_report/parent_pdf.php',
            method: 'POST',
            target: '_blank'
        });

        var params = {
            courseid: "{{courseid}}",
            userid: "{{userid}}",
            pdf_content: editedHtml
        };

        $.each(params, function(key, val) {
            form.append($('<input>', {
                type: 'hidden',
                name: key,
                value: val
            }));
        });

        $('body').append(form);
        form.submit();
        form.remove();
    });
});
{{/js}}

    {{/has_data}}

    {{^has_data}}
        {{! Empty State Notification }}
        <div class="alert alert-warning shadow-sm">
            <i class="fa fa-exclamation-triangle"></i> {{#str}}nodatafound, local_comp_report_ext{{/str}}
        </div>
    {{/has_data}}
</div>
