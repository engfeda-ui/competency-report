{{#js}}
require(['core/chartjs', 'jquery'], function(Chart, $) {

    var studentsData = {{{student_list_json}}};

    // Modal Helper Function
    function openDrilldownModal(title, filteredStudents) {
        $('#modal-drilldown-title').text(title);
        var tbody = $('#modal-drilldown-tbody');
        tbody.empty();

        if (!filteredStudents || filteredStudents.length === 0) {
            tbody.append('<tr><td colspan="4" class="text-center text-muted py-4"><i class="fa fa-info-circle mr-1"></i> No students found in this category.</td></tr>');
        } else {
            $.each(filteredStudents, function(i, s) {
                var row = $('<tr>');
                row.append('<td class="pl-4 font-weight-bold align-middle">' + s.fullname + '</td>');
                row.append('<td class="text-center align-middle font-weight-bold">' + s.average + '%</td>');
                row.append('<td class="text-center align-middle"><span class="badge ' + s.badge_class + ' px-2 py-1">' + s.tier_name + '</span></td>');
                row.append('<td class="text-right pr-4 align-middle"><a href="' + s.detail_url + '" class="btn btn-sm btn-outline-primary font-weight-bold"><i class="fa fa-file-text-o mr-1"></i> View Report</a></td>');
                tbody.append(row);
            });
        }

        $('#modal-student-drilldown').modal('show');
    }

    // Roster Filter Helper
    function filterRosterTable(filterType) {
        $('#roster-filter-group button').removeClass('active');
        $('#roster-filter-group button[data-filter="' + filterType + '"]').addClass('active');

        $('.roster-row').each(function() {
            var $row = $(this);
            if (filterType === 'all') {
                $row.show();
            } else if (filterType === 'remediation' || filterType === 'failed') {
                if ($row.data('remediation') == 1) { $row.show(); } else { $row.hide(); }
            } else if (filterType.indexOf('decile_') === 0) {
                var decile = filterType.replace('decile_', '');
                if ($row.data('decile') == decile) { $row.show(); } else { $row.hide(); }
            } else {
                if ($row.data('tier') === filterType) { $row.show(); } else { $row.hide(); }
            }
        });
    }

    // Filter Button Click Handlers
    $('#roster-filter-group button').on('click', function() {
        var filter = $(this).data('filter');
        filterRosterTable(filter);
    });

    // KPI Cards Click Handlers
    $('#btn-kpi-remediation').on('click', function() {
        var list = studentsData.filter(function(s) { return s.needs_remediation; });
        openDrilldownModal('At-Risk Students (' + list.length + ')', list);
        filterRosterTable('remediation');
    });

    $('#btn-kpi-all-students').on('click', function() {
        openDrilldownModal('All Students (' + studentsData.length + ')', studentsData);
        filterRosterTable('all');
    });

    // Print Report
    $('#btn-print-analytics').on('click', function(e) {
        e.preventDefault();
        window.print();
    });

    // 1. Raw Exam Score Decile Histogram Bar Chart
    var histCtx = document.getElementById('chart-exam-histogram').getContext('2d');
    new Chart(histCtx, {
        type: 'bar',
        data: {
            labels: {{{histogram_labels_json}}},
            datasets: [{
                label: '{{#str}}user, local_comp_report_ext{{/str}}',
                data: {{{histogram_data_json}}},
                backgroundColor: [
                    'rgba(220, 38, 38, 0.75)',
                    'rgba(239, 68, 68, 0.75)',
                    'rgba(249, 115, 22, 0.75)',
                    'rgba(245, 158, 11, 0.75)',
                    'rgba(234, 179, 8, 0.75)',
                    'rgba(202, 138, 4, 0.75)',
                    'rgba(59, 130, 246, 0.75)',
                    'rgba(37, 99, 235, 0.75)',
                    'rgba(16, 185, 129, 0.75)',
                    'rgba(5, 150, 105, 0.75)'
                ],
                borderColor: [
                    '#DC2626',
                    '#EF4444',
                    '#F97316',
                    '#F59E0B',
                    '#EAB308',
                    '#CA8A04',
                    '#3B82F6',
                    '#2563EB',
                    '#10B981',
                    '#059669'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1 }
                }
            },
            onClick: function(evt, activeElements) {
                if (activeElements && activeElements.length > 0) {
                    var index = activeElements[0].index;
                    var labels = ['0-10%', '11-20%', '21-30%', '31-40%', '41-50%', '51-60%', '61-70%', '71-80%', '81-90%', '91-100%'];
                    var binLabel = labels[index];

                    var list = studentsData.filter(function(s) { return s.decile_bin === index; });
                    openDrilldownModal('Students with Score ' + binLabel + ' (' + list.length + ')', list);
                    filterRosterTable('decile_' + index);
                }
            }
        }
    });

    // 2. Academic Grade Performance Tiers Doughnut Chart
    var tierCtx = document.getElementById('chart-exam-tiers').getContext('2d');
    new Chart(tierCtx, {
        type: 'doughnut',
        data: {
            labels: [
                '{{#str}}grade_tier_failed, local_comp_report_ext{{/str}}',
                '{{#str}}grade_tier_passing, local_comp_report_ext{{/str}}',
                '{{#str}}grade_tier_verygood, local_comp_report_ext{{/str}}',
                '{{#str}}grade_tier_outstanding, local_comp_report_ext{{/str}}'
            ],
            datasets: [{
                data: {{{tier_data_json}}},
                backgroundColor: [
                    'rgba(239, 68, 68, 0.85)',
                    'rgba(245, 158, 11, 0.85)',
                    'rgba(59, 130, 246, 0.85)',
                    'rgba(16, 185, 129, 0.85)'
                ],
                borderColor: '#ffffff',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            },
            onClick: function(evt, activeElements) {
                if (activeElements && activeElements.length > 0) {
                    var index = activeElements[0].index;
                    var tiers = ['failed', 'passing', 'verygood', 'outstanding'];
                    var tierTitles = ['At-Risk Students (< 60%)', 'Satisfactory Students (60-74%)', 'Very Good Students (75-89%)', 'Outstanding Students (90-100%)'];
                    var targetTier = tiers[index];
                    var title = tierTitles[index];

                    var list = studentsData.filter(function(s) { return s.tier === targetTier; });
                    openDrilldownModal(title + ' (' + list.length + ')', list);
                    filterRosterTable(targetTier);
                }
            }
        }
    });

    // 3. Question Item Difficulty p-value Chart
    var diffCtx = document.getElementById('chart-item-difficulty').getContext('2d');
    new Chart(diffCtx, {
        type: 'bar',
        data: {
            labels: {{{item_labels_json}}},
            datasets: [{
                label: 'Difficulty Index (p-value %)',
                data: {{{item_difficulty_json}}},
                backgroundColor: 'rgba(59, 130, 246, 0.75)',
                borderColor: '#2563EB',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { min: 0, max: 100, ticks: { stepSize: 20 } }
            }
        }
    });

    // 4. Question Item Discrimination Index Chart
    var discCtx = document.getElementById('chart-item-discrimination').getContext('2d');
    new Chart(discCtx, {
        type: 'bar',
        data: {
            labels: {{{item_labels_json}}},
            datasets: [{
                label: 'Discrimination Index (%)',
                data: {{{item_discrim_json}}},
                backgroundColor: 'rgba(16, 185, 129, 0.75)',
                borderColor: '#059669',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { min: 0, max: 100, ticks: { stepSize: 20 } }
            }
        }
    });
});
{{/js}}
