<div class="local_comp_report_ext_group_assessment_distribution">
    <!-- Consolidated Tab Navigation -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_competency.php?courseid={{courseid}}">
                <i class="fa fa-list-alt mr-1"></i> {{#str}}tab_by_competency, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_quiz_competency.php?courseid={{courseid}}">
                <i class="fa fa-pencil-square-o mr-1"></i> {{#str}}tab_by_quiz, local_comp_report_ext{{/str}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active font-weight-bold" href="#">
                <i class="fa fa-balance-scale mr-1"></i> {{#str}}tab_assessment_distribution, local_comp_report_ext{{/str}}
            </a>
        </li>
    </ul>

    {{^has_configured_asmts}}
        <div class="alert alert-warning shadow-sm">
            <i class="fa fa-exclamation-triangle mr-2"></i>
            {{#str}}noassessmentsconfigured, local_comp_report_ext{{/str}}
            <div class="mt-2">
                <a href="assessment_setup.php?courseid={{courseid}}" class="btn btn-sm btn-primary">
                    <i class="fa fa-cog mr-1"></i> {{#str}}goassessmentsetup, local_comp_report_ext{{/str}}
                </a>
            </div>
        </div>
    {{/has_configured_asmts}}

    {{#has_configured_asmts}}
        <form method="get" class="card card-body bg-light mb-4 shadow-sm">
            <input type="hidden" name="courseid" value="{{courseid}}">

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="font-weight-bold mb-1"><i class="fa fa-users mr-1"></i> {{#str}}group, local_comp_report_ext{{/str}}</label>
                    <select name="groupid" class="form-control">
                        {{#groups}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/groups}}
                    </select>
                </div>

                <div class="col-md-8 mb-3">
                    <label class="font-weight-bold mb-1"><i class="fa fa-check-square-o mr-1"></i> {{#str}}selectassessments, local_comp_report_ext{{/str}}</label>
                    <div class="d-flex flex-wrap p-2 border rounded bg-white" style="max-height: 120px; overflow-y: auto;">
                        {{#asmtcheckboxes}}
                            <div class="custom-control custom-checkbox mr-4 mb-1">
                                <input type="checkbox" class="custom-control-input" id="asmt_cb_{{id}}" name="assessmentids[]" value="{{id}}" {{#checked}}checked{{/checked}}>
                                <label class="custom-control-label font-weight-normal" for="asmt_cb_{{id}}">
                                    {{name}} <span class="badge badge-secondary ml-1">{{weight}}%</span>
                                </label>
                            </div>
                        {{/asmtcheckboxes}}
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center mt-2">
                <button type="submit" class="btn btn-primary mr-2">
                    <i class="fa fa-filter mr-1"></i> {{#str}}show, local_comp_report_ext{{/str}}
                </button>
                {{#has_data}}
                    <button id="btn-export-asmtdist-pdf-top" class="btn btn-outline-danger font-weight-bold shadow-sm">
                        <i class="fa fa-file-pdf-o mr-1"></i> {{#str}}exportpdf, local_comp_report_ext{{/str}}
                    </button>
                {{/has_data}}
            </div>
        </form>

        {{#has_data}}
            <div class="table-responsive">
                <table class="generaltable table table-bordered table-hover mt-3 shadow-sm bg-white">
                    <thead class="thead-dark">
                        <tr>
                            <th style="vertical-align: middle;">{{#str}}student, local_comp_report_ext{{/str}}</th>
                            {{#show_group_col}}
                                <th style="vertical-align: middle;">{{#str}}group, local_comp_report_ext{{/str}}</th>
                            {{/show_group_col}}
                            <th style="vertical-align: middle;">{{#str}}competency, local_comp_report_ext{{/str}}</th>
                            {{#asmtheaders}}
                                <th class="text-center" style="vertical-align: middle;">
                                    {{name}}<br>
                                    <small class="badge badge-light text-dark mt-1">{{weight}}%</small>
                                </th>
                            {{/asmtheaders}}
                            <th class="text-center" style="vertical-align: middle;">{{#str}}weightedtotal, local_comp_report_ext{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr class="{{#is_even}}table-light{{/is_even}}">
                                {{#first_row}}
                                    <td rowspan="{{rowspan}}" style="vertical-align: middle; background-color: inherit;" class="font-weight-bold">
                                        {{{studentlink}}}
                                    </td>
                                    {{#show_group_col}}
                                        <td rowspan="{{rowspan}}" style="vertical-align: middle; background-color: inherit;">
                                            <span class="badge badge-info">{{groupname}}</span>
                                        </td>
                                    {{/show_group_col}}
                                {{/first_row}}
                                <td style="vertical-align: middle;">
                                    <span class="font-weight-bold">{{shortname}}</span>
                                </td>
                                {{#asmt_cells}}
                                    <td class="text-center" style="vertical-align: middle;">
                                        {{#has_score}}%{{score_pct}}{{/has_score}}
                                        {{^has_score}}<span class="text-muted">—</span>{{/has_score}}
                                    </td>
                                {{/asmt_cells}}
                                <td class="text-center font-weight-bold" style="vertical-align: middle; color: {{color}};">
                                    {{#has_total}}
                                        %{{total_percent}}
                                        {{#passed}}<i class="fa fa-check-circle text-success ml-1" title="Passed"></i>{{/passed}}
                                        {{^passed}}<i class="fa fa-exclamation-circle text-danger ml-1" title="At Risk"></i>{{/passed}}
                                    {{/has_total}}
                                    {{^has_total}}<span class="text-muted">—</span>{{/has_total}}
                                </td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>

            {{! Reusable AI Commentary & Focus Widget }}
            {{> local_comp_report_ext/ai_commentary_widget }}
        {{/has_data}}

        {{^has_data}}
            <div class="alert alert-info shadow-sm">
                <i class="fa fa-info-circle mr-1"></i> {{#str}}noexamdata, local_comp_report_ext{{/str}}
            </div>
        {{/has_data}}
    {{/has_configured_asmts}}
</div>

{{#js}}
require(['jquery'], function($) {
    $('#btn-export-asmtdist-pdf-top').on('click', function(e) {
        e.preventDefault();
        var editedHtml = '';
        var aiContent = $('.ai-content-html');
        if (aiContent.length && aiContent.html().trim() !== '') {
            editedHtml = aiContent.html();
        }

        var form = $('<form>', {
            action: M.cfg.wwwroot + '/local/comp_report_ext/group_assessment_distribution_pdf.php',
            method: 'POST',
            target: '_blank'
        });

        var params = {
            courseid: "{{courseid}}",
            groupid: "{{groupid}}",
            assessmentids_json: '{{{validasmtids_json}}}',
            pdf_content: editedHtml
        };

        $.each(params, function(key, val) {
            form.append($('<input>', {
                type: 'hidden',
                name: key,
                value: val
            }));
        });

        $('body').append(form);
        form.submit();
        form.remove();
    });
});
{{/js}}
