{{!
    @template local_comp_report_ext/teacher_report

    Teacher view for student competency performance.

    Context variables required for this template:
    * form_html - The rendered Moodle form HTML.
    * has_selection - Whether a student and competency have been selected.
    * description - Competency description.
    * has_rows - Whether performance data exists.
    * rows - Array of quiz performance data.
    * total - Summary data for the footer.
    * has_questions - Whether question detail links exist.
    * questiondetails - Array of individual question attempts.

    Example context (json):
    {
        "form_html": "<form>Mock Form</form>",
        "has_selection": true,
        "description": "Competency info",
        "has_rows": true,
        "rows": [
            {
                "quizname": "Quiz 1",
                "quizurl": "#",
                "questions": 10,
                "correct": 8,
                "rate": "80.0",
                "color": "green"
            }
        ],
        "total": {
            "questions": 10,
            "correct": 8,
            "rate": "80.0",
            "color": "green"
        },
        "has_questions": true,
        "questiondetails": [
            {
                "quizname": "Quiz 1",
                "questionname": "Q1",
                "url": "#"
            }
        ]
    }
}}
<div class="local_comp_report_ext_teacher_report">
    {{! Filter Form }}
    <div class="card mb-4 p-3 bg-light border-0 shadow-sm">
        <div class="card-body">{{{form_html}}}</div>
    </div>

    {{#has_selection}}
        {{! 2. Competency Description }}
        {{#description}}
        <div class="alert alert-info border-left-info shadow-sm mb-4">
            <i class="fa fa-info-circle"></i> {{{description}}}
        </div>
        {{/description}}

        {{#has_rows}}
            {{! Summary Performance Table }}
            <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                <h4 class="mb-0">{{#str}}summaryreport, local_comp_report_ext{{/str}}</h4>
                <div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mr-2" onclick="window.print()">
                        <i class="fa fa-print mr-1"></i> {{#str}}print, core{{/str}}
                    </button>
                    <button type="button" id="btn-export-teacher-comp-excel" class="btn btn-outline-success btn-sm">
                        <i class="fa fa-file-excel-o mr-1"></i> {{#str}}exportexcel, local_comp_report_ext{{/str}}
                    </button>
                </div>
            </div>
            <div class="table-responsive">
                <table id="teacher-student-comp-table" class="generaltable table table-bordered table-hover mt-3 shadow-sm bg-white">
                    <thead class="thead-dark">
                        <tr>
                            <th>{{#str}}quiz, local_comp_report_ext{{/str}}</th>
                            <th class="text-center">{{#str}}question, local_comp_report_ext{{/str}}</th>
                            <th class="text-center">{{#str}}correct, local_comp_report_ext{{/str}}</th>
                            <th class="text-center">{{#str}}success, local_comp_report_ext{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                        <tr>
                            <td><a href="{{quizurl}}" target="_blank"><strong>{{quizname}}</strong></a></td>
                            <td class="text-center">{{questions}}</td>
                            <td class="text-center">{{correct}}</td>
                            <td class="text-center font-weight-bold" style="color: {{color}};">%{{rate}}</td>
                        </tr>
                        {{/rows}}
                    </tbody>
                    {{#total}}
                    <tfoot>
                        <tr class="table-secondary font-weight-bold">
                            <td>{{#str}}total, local_comp_report_ext{{/str}}</td>
                            <td class="text-center">{{questions}}</td>
                            <td class="text-center">{{correct}}</td>
                            <td class="text-center" style="color: {{color}};">%{{rate}}</td>
                        </tr>
                    </tfoot>
                    {{/total}}
                </table>
            </div>
        {{/has_rows}}

        {{#has_questions}}
            {{! Detailed Question Links with Modal Trigger }}
            <h4 class="mt-5">{{#str}}questionlinks, local_comp_report_ext{{/str}}</h4>
            <div class="table-responsive">
                <table class="generaltable table table-bordered table-hover mt-3 shadow-sm bg-white">
                    <thead class="thead-light">
                        <tr>
                            <th>{{#str}}quiz, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}questionname, local_comp_report_ext{{/str}}</th>
                            <th class="text-center">{{#str}}action, local_comp_report_ext{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#questiondetails}}
                        <tr>
                            <td>{{quizname}}</td>
                            <td>{{questionname}}</td>
                            <td class="text-center">
                                <a href="{{url}}" class="btn btn-sm btn-outline-primary view-question-modal" target="_blank">
                                    <i class="fa fa-search"></i> {{#str}}viewattempt, local_comp_report_ext{{/str}}
                                </a>
                            </td>
                        </tr>
                        {{/questiondetails}}
                    </tbody>
                </table>
            </div>
        {{/has_questions}}

        {{^has_rows}}
            <div class="alert alert-info mt-4">{{#str}}nodatastudentcompetency, local_comp_report_ext{{/str}}</div>
        {{/has_rows}}
    {{/has_selection}}
</div>

{{#js}}
require(['jquery', 'local_comp_report_ext/modal_viewer'], function($, ModalViewer) {
    ModalViewer.init('.view-question-modal');

    $('#btn-export-teacher-comp-excel').on('click', function() {
        var rows = [];
        rows.push(['"{{#str}}quiz, local_comp_report_ext{{/str}}"', '"{{#str}}question, local_comp_report_ext{{/str}}"', '"{{#str}}correct, local_comp_report_ext{{/str}}"', '"{{#str}}success, local_comp_report_ext{{/str}}"'].join(','));
        $('#teacher-student-comp-table tbody tr, #teacher-student-comp-table tfoot tr').each(function() {
            var cols = [];
            $(this).find('td').each(function() {
                var text = $(this).text().replace(/\s+/g, ' ').trim();
                cols.push('"' + text.replace(/"/g, '""') + '"');
            });
            if (cols.length) { rows.push(cols.join(',')); }
        });
        var csvContent = '\uFEFF' + rows.join('\n');
        var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Teacher_Student_Competency_Analysis_' + new Date().toISOString().slice(0,10) + '.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
});
{{/js}}
