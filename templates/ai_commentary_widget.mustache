{{!
    Reusable AI Commentary Widget
    Template variables:
    * courseid
    * userid (optional)
    * groupid (optional)
    * quizid (optional)
    * context_type (student, school, group, quiz)
}}
<div class="ai-commentary mt-4 mb-4" id="ai-report-container-{{context_type}}">
    <div class="card border-info shadow-sm bg-light">
        <div class="card-body">
            <h4 class="card-title text-info border-bottom pb-2 mb-3">
                <i class="fa fa-magic mr-2"></i> {{#str}}generalcomment, local_comp_report_ext{{/str}} (AI Analysis)
            </h4>

            <!-- Focus Type Selector (Competency vs. General Grades) -->
            <div class="form-group mb-3">
                <label class="font-weight-bold text-muted d-block mb-2">
                    <i class="fa fa-sliders mr-1"></i> {{#str}}ai_analysis_focus, local_comp_report_ext{{/str}}
                </label>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-info active mr-2 mb-2 font-weight-bold" id="btn-focus-competency-{{context_type}}" style="transition: all 0.2s ease;">
                        <i class="fa fa-crosshairs mr-1"></i> {{#str}}ai_focus_competency, local_comp_report_ext{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-info mb-2 font-weight-bold" id="btn-focus-grades-{{context_type}}" style="transition: all 0.2s ease;">
                        <i class="fa fa-bar-chart mr-1"></i> {{#str}}ai_focus_grades, local_comp_report_ext{{/str}}
                    </button>
                </div>
            </div>

            <!-- Custom Prompt Input -->
            <div class="form-group mb-3">
                <label for="custom-prompt-input-{{context_type}}" class="font-weight-bold text-muted">
                    <i class="fa fa-pencil-square-o mr-1"></i> {{#str}}opt_instructions, local_comp_report_ext{{/str}}
                </label>
                <input type="text" id="custom-prompt-input-{{context_type}}" class="form-control form-control-lg bg-white shadow-inner" placeholder="{{#str}}custom_prompt_placeholder, local_comp_report_ext{{/str}}" style="border: 1px solid #ced4da; border-radius: 8px;">
                <small class="form-text text-muted">Write custom instructions to guide the AI report (e.g. language, length, focus).</small>
            </div>

            <!-- Trigger Action Button -->
            <div class="d-flex align-items-center mb-3">
                <button id="btn-generate-ai-{{context_type}}" class="btn btn-info btn-lg px-4 font-weight-bold shadow-sm" style="border-radius: 8px;">
                    <i class="fa fa-play mr-2"></i> {{#str}}btn_generate_ai, local_comp_report_ext{{/str}}
                </button>
            </div>

            <!-- Loading Spinner (Hidden by default) -->
            <div id="ai-loading-{{context_type}}" class="d-none align-items-center text-info p-3 bg-white rounded border mb-3 shadow-inner">
                <div class="spinner-border mr-3" role="status" style="width: 2rem; height: 2rem;">
                     <span class="sr-only">Loading...</span>
                </div>
                <div>
                    <strong class="d-block text-dark">Analyzing performance metrics...</strong>
                    <span class="text-muted small">AI is generating a structured pedagogical commentary. Please wait.</span>
                </div>
            </div>

            <!-- Results Alert Box (Hidden by default) -->
            <div id="ai-response-box-{{context_type}}" class="d-none alert alert-light border border-info shadow-inner p-4 rounded-lg bg-white" style="border-left: 5px solid #17a2b8 !important;">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="text-info font-weight-bold mb-0">
                        <i class="fa fa-magic mr-1"></i> AI Feedback Report
                    </h5>
                    <button type="button" id="btn-export-pdf-{{context_type}}" class="btn btn-outline-danger btn-sm font-weight-bold shadow-sm" style="border-radius: 6px; transition: all 0.2s ease;">
                        <i class="fa fa-file-pdf-o mr-1"></i> {{#str}}exportpdf, local_comp_report_ext{{/str}}
                    </button>
                </div>
                <div class="ai-content-html text-dark leading-relaxed p-2" style="font-size: 1.05rem; line-height: 1.6;">
                    <!-- AI response will be injected here as formatted HTML -->
                </div>
            </div>
        </div>
    </div>
</div>

{{! AI Study Plan Section — shown when userid is available (student context) }}
{{#userid}}
<div class="ai-studyplan mt-3 mb-4" id="studyplan-container-{{userid}}">
    <div class="card border-0 shadow-sm" style="border-left: 5px solid #28a745; border-left-width: 5px;">
        <div class="card-body">
            <h5 class="card-title font-weight-bold mb-3" style="color: #28a745;">
                <i class="fa fa-list-alt mr-2"></i> AI Personalized Study Plan
            </h5>
            <p class="text-muted small mb-3">
                {{#str}}studyplan_desc, local_comp_report_ext{{/str}}
            </p>

            {{! Controls Row: Language + Sessions + Button }}
            <div class="row align-items-end mb-2">
                {{! Language Selector }}
                <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                    <label for="studyplan-lang-{{userid}}" class="font-weight-bold text-muted small d-block mb-1">
                        <i class="fa fa-language mr-1"></i> {{#str}}studyplan_language, local_comp_report_ext{{/str}}
                    </label>
                    <select id="studyplan-lang-{{userid}}" class="form-control form-control-sm bg-white" style="border-radius: 6px; height: 36px; border: 1px solid #ced4da;">
                        <option value="English">🇬🇧 English</option>
                        <option value="Arabic">🇸🇦 العربية</option>
                    </select>
                </div>

                {{! Sessions Input }}
                <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                    <label for="studyplan-sessions-{{userid}}" class="font-weight-bold text-muted small d-block mb-1">
                        <i class="fa fa-clock-o mr-1"></i> {{#str}}studyplan_sessions_label, local_comp_report_ext{{/str}}
                    </label>
                    <div class="input-group input-group-sm">
                        <input type="number"
                               id="studyplan-sessions-{{userid}}"
                               class="form-control"
                               value="10"
                               min="1"
                               max="60"
                               style="max-width: 80px; text-align: center; font-weight: bold; height: 36px; border-radius: 6px 0 0 6px;"
                        />
                        <div class="input-group-append">
                            <span class="input-group-text small" style="border-radius: 0 6px 6px 0; height: 36px; display: flex; align-items: center;">{{#str}}studyplan_sessions_unit, local_comp_report_ext{{/str}}</span>
                        </div>
                    </div>
                </div>

                {{! Generate Button }}
                <div class="col-md-6 col-sm-12 text-md-right align-self-end">
                    <button id="btn-studyplan-{{userid}}" class="btn btn-success px-4 font-weight-bold shadow-sm w-100 w-md-auto" style="border-radius: 8px; height: 38px; min-width: 240px; transition: all 0.2s ease;">
                        <i class="fa fa-graduation-cap mr-2"></i> {{#str}}btn_studyplan, local_comp_report_ext{{/str}}
                    </button>
                </div>
            </div>

            {{! Helper Text Div (outside the row to keep inputs perfectly aligned) }}
            <div class="text-muted small mb-3 mt-2">
                <i class="fa fa-info-circle mr-1"></i>{{#str}}studyplan_session_hint, local_comp_report_ext{{/str}}
            </div>

            {{! Loading Spinner }}
            <div id="studyplan-loading-{{userid}}" class="d-none align-items-center text-success p-3 bg-white rounded border mt-2 shadow-inner">
                <div class="spinner-border mr-3 text-success" role="status" style="width: 1.8rem; height: 1.8rem;">
                    <span class="sr-only">Loading...</span>
                </div>
                <strong class="d-block text-dark">{{#str}}studyplan_generating, local_comp_report_ext{{/str}}</strong>
            </div>

            {{! Result Box (hidden until generated) }}
            <div id="studyplan-result-{{userid}}" class="d-none mt-3 p-4 bg-white rounded border shadow-inner" style="border-left: 5px solid #28a745;">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="font-weight-bold mb-0" style="color:#28a745;">
                        <i class="fa fa-check-circle mr-2"></i> {{#str}}studyplan_title, local_comp_report_ext{{/str}}
                    </h5>
                    {{! PDF Export Button — appears after plan is generated }}
                    <button type="button"
                       id="btn-studyplan-pdf-{{userid}}"
                       class="btn btn-outline-danger btn-sm font-weight-bold shadow-sm"
                       style="border-radius: 6px; transition: all 0.2s ease;">
                        <i class="fa fa-file-pdf-o mr-1"></i> {{#str}}btn_studyplan_pdf, local_comp_report_ext{{/str}}
                    </button>
                </div>
                <div class="studyplan-content text-dark p-2" style="font-size: 1rem; line-height: 1.7;"></div>
            </div>
        </div>
    </div>
</div>
{{/userid}}

{{#js}}
require(['jquery'], function($) {
    var context = "{{context_type}}";
    var btn = $('#btn-generate-ai-' + context);
    var btnComp = $('#btn-focus-competency-' + context);
    var btnGrades = $('#btn-focus-grades-' + context);
    var loading = $('#ai-loading-' + context);
    var responseBox = $('#ai-response-box-' + context);
    var contentHtml = responseBox.find('.ai-content-html');
    
    var focusType = 'competency';

    function updatePdfUrl() {
        // Obsolete: We now use POST form submission to preserve manual edits.
    }

    // When PDF export is clicked, submit a POST form with the edited content.
    $('#btn-export-pdf-' + context).on('click', function(e) {
        e.preventDefault();
        var editedHtml = contentHtml.html();
        var targetUrl = M.cfg.wwwroot + '/local/competency_report/school_pdf.php';
        if (context === 'student') {
            targetUrl = M.cfg.wwwroot + '/local/competency_report/parent_pdf.php';
        } else if (context === 'group') {
            targetUrl = M.cfg.wwwroot + '/local/competency_report/group_competency_pdf.php';
        } else if (context === 'quiz') {
            targetUrl = M.cfg.wwwroot + '/local/competency_report/group_quiz_competency_pdf.php';
        } else if (context === 'course_master') {
            targetUrl = M.cfg.wwwroot + '/local/competency_report/course_master_report_pdf.php';
        }

        var form = $('<form>', {
            action: targetUrl,
            method: 'POST',
            target: '_blank'
        });

        var params = {
            courseid: "{{courseid}}",
            focus_type: focusType,
            custom_prompt: $('#custom-prompt-input-' + context).val(),
            pdf_content: editedHtml
        };
        if (context === 'student') {
            params.userid = "{{userid}}";
        } else if (context === 'group') {
            params.groupid = "{{groupid}}";
        } else if (context === 'quiz') {
            params.groupid = "{{groupid}}";
            params.quizid = "{{quizid}}";
        }

        $.each(params, function(key, val) {
            form.append($('<input>', {
                type: 'hidden',
                name: key,
                value: val
            }));
        });

        $('body').append(form);
        form.submit();
        form.remove();
    });

    btnComp.on('click', function(e) {
        e.preventDefault();
        btnComp.addClass('active btn-info text-white').removeClass('btn-outline-info');
        btnGrades.removeClass('active btn-info text-white').addClass('btn-outline-info');
        focusType = 'competency';
        updatePdfUrl();
    });

    btnGrades.on('click', function(e) {
        e.preventDefault();
        btnGrades.addClass('active btn-info text-white').removeClass('btn-outline-info');
        btnComp.removeClass('active btn-info text-white').addClass('btn-outline-info');
        focusType = 'grades';
        updatePdfUrl();
    });

    $('#custom-prompt-input-' + context).on('change keyup input', function() {
        updatePdfUrl();
    });

    btn.on('click', function(e) {
        e.preventDefault();
        var customPrompt = $('#custom-prompt-input-' + context).val();
        updatePdfUrl();
        
        // Show loading spinner
        loading.removeClass('d-none').addClass('d-flex');
        responseBox.addClass('d-none');
        btn.prop('disabled', true);

        $.ajax({
            url: M.cfg.wwwroot + '/local/competency_report/ajax_ai.php',
            type: 'POST',
            dataType: 'json',
            data: {
                courseid: "{{courseid}}",
                userid: "{{userid}}",
                groupid: "{{groupid}}",
                quizid: "{{quizid}}",
                custom_prompt: customPrompt,
                context_type: context,
                focus_type: focusType
            },
            success: function(data) {
                loading.removeClass('d-flex').addClass('d-none');
                btn.prop('disabled', false);
                if (data.success) {
                    contentHtml.html(data.html);
                    responseBox.removeClass('d-none');
                    updatePdfUrl();
                } else {
                    contentHtml.html('<div class="text-danger"><i class="fa fa-exclamation-circle mr-2"></i> Error: ' + data.error + '</div>');
                    responseBox.removeClass('d-none');
                }
            },
            error: function() {
                loading.removeClass('d-flex').addClass('d-none');
                btn.prop('disabled', false);
                contentHtml.html('<div class="text-danger"><i class="fa fa-exclamation-circle mr-2"></i> Connection failed. Please check local LLM / Ollama availability.</div>');
                responseBox.removeClass('d-none');
            }
        });
    });

    // Initial URL sync.
    updatePdfUrl();
});
{{/js}}

{{#userid}}
{{#js}}
require(['jquery'], function($) {
    var uid = '{{userid}}';
    var btnPlan = $('#btn-studyplan-' + uid);
    var loadingPlan = $('#studyplan-loading-' + uid);
    var resultPlan = $('#studyplan-result-' + uid);
    var contentPlan = resultPlan.find('.studyplan-content');

    if (!btnPlan.length) { return; }

    btnPlan.on('click', function(e) {
        e.preventDefault();
        loadingPlan.removeClass('d-none').addClass('d-flex');
        resultPlan.addClass('d-none');
        btnPlan.prop('disabled', true);

        var selectedLang     = $('#studyplan-lang-' + uid).val() || 'English';
        var selectedSessions = parseInt($('#studyplan-sessions-' + uid).val()) || 10;
        // Clamp between 1 and 60.
        selectedSessions = Math.max(1, Math.min(60, selectedSessions));

        $.ajax({
            url: M.cfg.wwwroot + '/local/competency_report/ajax_studyplan.php',
            type: 'POST',
            dataType: 'json',
            data: {
                courseid: '{{courseid}}',
                userid: uid,
                language: selectedLang,
                sessions: selectedSessions
            },
            success: function(data) {
                loadingPlan.removeClass('d-flex').addClass('d-none');
                btnPlan.prop('disabled', false);
                if (data.success) {
                    contentPlan.html(data.html);
                    resultPlan.removeClass('d-none');

                    // Bind PDF export button click handler to submit form with edited content.
                    $('#btn-studyplan-pdf-' + uid).off('click').on('click', function(e) {
                        e.preventDefault();
                        var editedHtml = contentPlan.html();
                        var form = $('<form>', {
                            action: M.cfg.wwwroot + '/local/competency_report/studyplan_pdf.php',
                            method: 'POST',
                            target: '_blank'
                        });

                        var params = {
                            courseid: '{{courseid}}',
                            userid: uid,
                            language: selectedLang,
                            sessions: selectedSessions,
                            pdf_content: editedHtml
                        };

                        $.each(params, function(key, val) {
                            form.append($('<input>', {
                                type: 'hidden',
                                name: key,
                                value: val
                            }));
                        });

                        $('body').append(form);
                        form.submit();
                        form.remove();
                    });
                } else {
                    contentPlan.html('<div class="text-danger"><i class="fa fa-exclamation-circle mr-1"></i>' + (data.error || 'Error generating study plan.') + '</div>');
                    resultPlan.removeClass('d-none');
                }
            },
            error: function() {
                loadingPlan.removeClass('d-flex').addClass('d-none');
                btnPlan.prop('disabled', false);
                contentPlan.html('<div class="text-danger"><i class="fa fa-exclamation-circle mr-1"></i>Connection failed. Please check your AI settings.</div>');
                resultPlan.removeClass('d-none');
            }
        });
    });
});
{{/js}}
{{/userid}}
