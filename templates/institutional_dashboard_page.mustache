                                <input type="checkbox" class="custom-control-input" id="copt_{{id}}" name="courseids[]" value="{{id}}" {{#selected}}checked{{/selected}}>
                                <label class="custom-control-label small font-weight-bold" for="copt_{{id}}">{{name}}</label>
                            </div>
                            {{/course_options}}
