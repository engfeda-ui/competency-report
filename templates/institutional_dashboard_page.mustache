    <!-- Filter & Course Selection Bar -->
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body p-3">
            <form method="get" class="d-flex flex-wrap align-items-center justify-content-between">
                <input type="hidden" name="courseid" value="{{courseid}}">

                <div class="d-flex flex-wrap align-items-center mb-2 mb-md-0">
                    <div class="dropdown mr-3 mb-2 mb-sm-0">
                        <button class="btn btn-outline-primary dropdown-toggle shadow-sm font-weight-bold" type="button" id="courseMultiSelectDrop" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-book mr-1"></i> {{#str}}select_courses_specializations, local_comp_report_ext{{/str}}
                            <span class="badge badge-primary ml-1">{{selected_courses_count}}</span>
                        </button>
                        <div class="dropdown-menu p-3 shadow-lg" aria-labelledby="courseMultiSelectDrop" style="min-width: 320px; max-height: 400px; overflow-y: auto;">
