                <div class="h2 mb-0 font-weight-bold mt-2">{{total_specializations}}</div>
                <div class="small mt-1"><i class="fa fa-graduation-cap mr-1"></i> {{#str}}courses, core{{/str}}</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg bg-dark text-white h-100 p-3">
