            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom font-weight-bold text-primary d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-bar-chart mr-2"></i> {{#str}}cross_spec_analytics, local_comp_report_ext{{/str}}</span>
                    <span class="badge badge-primary">{{total_specializations}}</span>
                </div>
                <div class="card-body">
                    <div style="height: 240px; position: relative;">
                        <canvas id="specComparisonChart"></canvas>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>{{#str}}specialization, local_comp_report_ext{{/str}}</th>
                                    <th class="text-center">{{#str}}students, core{{/str}}</th>
                                    <th class="text-center">{{#str}}passed, core{{/str}}</th>
                                    <th class="text-center">{{#str}}average, core{{/str}}</th>
                                    <th class="text-center">{{#str}}passrate, local_comp_report_ext{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#spec_list}}
                                <tr>
