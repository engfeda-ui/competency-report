                    <button type="button" class="btn btn-secondary shadow-sm" onclick="window.print();">
                        <i class="fa fa-print mr-1"></i> {{strprintreport}}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Group-to-Region Mapping Panel (Collapsible) -->
    <div class="collapse mb-4" id="regionMappingPanel">
        <div class="card shadow-sm border-0 border-left-primary">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-primary font-weight-bold">
                    <i class="fa fa-sitemap mr-2"></i> {{#str}}map_groups_to_regions, local_comp_report_ext{{/str}}
                </h5>
                <span class="badge badge-light border">{{#str}}map_groups_desc, local_comp_report_ext{{/str}}</span>
            </div>
            <div class="card-body">
                <form method="post" action="institutional_dashboard.php?courseid={{courseid}}&action=save_mapping">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    {{#course_options}}
                    {{#selected}}
                    <input type="hidden" name="courseids[]" value="{{id}}">
                    {{/selected}}
                    {{/course_options}}

                    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>#</th>
                                    <th>{{#str}}specialization, local_comp_report_ext{{/str}}</th>
                                    <th>{{#str}}group_name, local_comp_report_ext{{/str}}</th>
                                    <th>{{#str}}region_name, local_comp_report_ext{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#all_groups}}
                                <tr>
                                    <td class="text-center">{{id}}</td>
                                    <td><span class="badge badge-info">{{coursename}}</span></td>
                                    <td class="font-weight-bold">{{name}}</td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" name="group_region[{{id}}]" value="{{region}}" list="regionSuggestions" placeholder="{{#str}}region_name, local_comp_report_ext{{/str}}">
                                            {{#is_suggested}}
                                            <div class="input-group-append">
                                                <span class="input-group-text bg-warning-light text-warning small font-weight-bold" title="{{#str}}auto_suggested_region, local_comp_report_ext{{/str}}">
                                                    <i class="fa fa-magic"></i>
                                                </span>
                                            </div>
                                            {{/is_suggested}}
                                        </div>
                                    </td>
                                </tr>
                                {{/all_groups}}
                            </tbody>
                        </table>
                    </div>

                    <datalist id="regionSuggestions">
                        <option value="{{#str}}region_central, local_comp_report_ext{{/str}}">
                        <option value="{{#str}}region_eastern, local_comp_report_ext{{/str}}">
                        <option value="{{#str}}region_western, local_comp_report_ext{{/str}}">
                        <option value="{{#str}}region_southern, local_comp_report_ext{{/str}}">
                    </datalist>

                    <div class="mt-3 text-right">
                        <button type="submit" class="btn btn-primary font-weight-bold shadow-sm">
