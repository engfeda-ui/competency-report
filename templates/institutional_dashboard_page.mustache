    {{#has_data}}
    <!-- Global KPI Scorecards -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg bg-primary text-white h-100 p-3">
