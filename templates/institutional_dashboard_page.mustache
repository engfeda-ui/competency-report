                            <button type="submit" class="btn btn-primary btn-sm btn-block">{{#str}}apply, core{{/str}}</button>
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline-secondary mr-2 shadow-sm font-weight-bold" data-toggle="collapse" data-target="#regionMappingPanel" aria-expanded="false" aria-controls="regionMappingPanel">
                        <i class="fa fa-map-marker mr-1 text-danger"></i> {{#str}}map_groups_to_regions, local_comp_report_ext{{/str}}
