                <div class="h2 mb-0 font-weight-bold mt-2">{{total_regions}}</div>
                <div class="small mt-1"><i class="fa fa-map mr-1"></i> {{#str}}region, local_comp_report_ext{{/str}}</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg bg-secondary text-white h-100 p-3">
                <div class="text-uppercase small font-weight-bold opacity-75">{{#str}}total_groups, local_comp_report_ext{{/str}}</div>
                <div class="h2 mb-0 font-weight-bold mt-2">{{total_groups}}</div>
                <div class="small mt-1"><i class="fa fa-users mr-1"></i> {{#str}}groups, core{{/str}}</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg bg-success text-white h-100 p-3">
                <div class="text-uppercase small font-weight-bold opacity-75">{{#str}}cohort_pass_rate, local_comp_report_ext{{/str}}</div>
                <div class="h2 mb-0 font-weight-bold mt-2">{{overall_pass_rate}}%</div>
                <div class="small mt-1"><i class="fa fa-check-circle mr-1"></i> ≥ 60 / 100</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg bg-warning text-dark h-100 p-3">
                <div class="text-uppercase small font-weight-bold opacity-75">{{#str}}cohort_overall_avg, local_comp_report_ext{{/str}}</div>
                <div class="h2 mb-0 font-weight-bold mt-2">{{overall_avg_score}}</div>
