            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom font-weight-bold text-primary d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-map-marker mr-2 text-danger"></i> {{#str}}cross_region_analytics, local_comp_report_ext{{/str}}</span>
                    <span class="badge badge-dark">{{total_regions}}</span>
                </div>
                <div class="card-body">
                    <div style="height: 240px; position: relative;">
                        <canvas id="regionComparisonChart"></canvas>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>{{#str}}region, local_comp_report_ext{{/str}}</th>
                                    <th class="text-center">{{#str}}courses, core{{/str}}</th>
                                    <th class="text-center">{{#str}}groups, core{{/str}}</th>
                                    <th class="text-center">{{#str}}students, core{{/str}}</th>
                                    <th class="text-center">{{#str}}average, core{{/str}}</th>
                                    <th class="text-center">{{#str}}passrate, local_comp_report_ext{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#region_list}}
                                <tr>
                                    <td class="font-weight-bold"><i class="fa fa-map-pin mr-1 text-danger"></i> {{name}}</td>
                                    <td class="text-center">{{spec_count}}</td>
                                    <td class="text-center">{{group_count}}</td>
                                    <td class="text-center">{{total}}</td>
                                    <td class="text-center">{{avg_score}}</td>
                                    <td class="text-center"><span class="badge {{badge}}">{{pass_rate}}%</span></td>
                                </tr>
                                {{/region_list}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Master Student Roster -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center">
            <h5 class="mb-2 mb-md-0 text-primary font-weight-bold">
                <i class="fa fa-users mr-2"></i> {{#str}}master_student_roster, local_comp_report_ext{{/str}}
                <span class="badge badge-secondary ml-1" id="rosterCountBadge">{{total_students}}</span>
            </h5>
            <div class="d-flex flex-wrap align-items-center">
                <input type="text" id="rosterSearchInput" class="form-control form-control-sm mr-2 mb-2 mb-sm-0" style="min-width: 220px;" placeholder="{{#str}}search_student_ph, local_comp_report_ext{{/str}}">
                <select id="specFilterSelect" class="custom-select custom-select-sm mr-2 mb-2 mb-sm-0">
                    <option value="">{{#str}}filter_by_spec, local_comp_report_ext{{/str}} ({{#str}}all, core{{/str}})</option>
                    {{#spec_list}}
                    <option value="{{name}}">{{name}}</option>
                    {{/spec_list}}
                </select>
                <select id="regionFilterSelect" class="custom-select custom-select-sm mr-2 mb-2 mb-sm-0">
                    <option value="">{{#str}}filter_by_region, local_comp_report_ext{{/str}} ({{#str}}all, core{{/str}})</option>
                    {{#region_list}}
                    <option value="{{name}}">{{name}}</option>
                    {{/region_list}}
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 text-center" id="masterStudentTable">
                    <thead class="thead-dark small">
                        <tr>
                            <th>#</th>
                            <th class="text-left">{{#str}}student, core{{/str}}</th>
                            <th>{{#str}}idnumber, core{{/str}}</th>
                            <th>{{#str}}specialization, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}region, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}group, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}theory_score_30, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}practical_score_40, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}participation_20, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}assignments_10, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}term_total_100, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}gpa, local_comp_report_ext{{/str}}</th>
                            <th>{{#str}}status, core{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#student_list}}
                        <tr class="student-row" data-name="{{fullname}}" data-id="{{idnumber}}" data-email="{{email}}" data-spec="{{coursename}}" data-region="{{region}}" data-group="{{groupname}}">
                            <td>{{id}}</td>
                            <td class="text-left font-weight-bold">
                                <a href="{{detail_url}}" class="text-primary">{{fullname}}</a>
                            </td>
                            <td><code>{{idnumber}}</code></td>
                            <td><span class="badge badge-info">{{courseshortname}}</span></td>
                            <td><span class="badge badge-dark">{{region}}</span></td>
                            <td><span class="badge badge-light border">{{groupname}}</span></td>
                            <td class="{{#theory_pass}}text-success font-weight-bold{{/theory_pass}}{{^theory_pass}}text-danger{{/theory_pass}}">{{best_theory}}</td>
                            <td>
                                {{#has_practical}}
                                <span class="{{#prac_pass}}text-success font-weight-bold{{/prac_pass}}{{^prac_pass}}text-danger{{/prac_pass}}">{{best_practical}}</span>
                                {{/has_practical}}
                                {{^has_practical}}
                                <span class="text-muted">—</span>
                                {{/has_practical}}
                            </td>
                            <td>{{participation}}</td>
                            <td>{{assignments}}</td>
                            <td class="font-weight-bold h6 mb-0">{{term_total}}</td>
                            <td><span class="badge {{gpa_badge}}">{{gpa_letter}} ({{gpa_value}})</span></td>
                            <td>
                                {{#overall_pass}}
                                <span class="badge badge-success px-2 py-1"><i class="fa fa-check"></i> {{#str}}term_passed, local_comp_report_ext{{/str}}</span>
                                {{/overall_pass}}
                                {{^overall_pass}}
                                <span class="badge badge-danger px-2 py-1"><i class="fa fa-times"></i> {{#str}}term_failed, local_comp_report_ext{{/str}}</span>
                                {{/overall_pass}}
                            </td>
                        </tr>
                        {{/student_list}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/has_data}}

    {{^has_data}}
    <div class="alert alert-info shadow-sm p-4 text-center">
        <i class="fa fa-info-circle fa-2x mb-3 text-info"></i>
        <h5 class="font-weight-bold">{{#str}}no_courses_selected, local_comp_report_ext{{/str}}</h5>
        <p class="mb-0 text-muted">{{#str}}select_courses_help, local_comp_report_ext{{/str}}</p>
    </div>
    {{/has_data}}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Initialize Chart.js for Specializations & Regions if data exists.
    {{#has_data}}
    if (typeof Chart !== 'undefined') {
        // Specializations Chart
        var specCtx = document.getElementById('specComparisonChart');
        if (specCtx) {
            new Chart(specCtx, {
                type: 'bar',
                data: {
                    labels: {{{spec_labels_json}}},
                    datasets: [
                        {
                            label: '{{#str}}passrate, local_comp_report_ext{{/str}} %',
                            data: {{{spec_pass_json}}},
                            backgroundColor: 'rgba(40, 167, 69, 0.75)',
                            borderColor: '#28a745',
                            borderWidth: 1,
                            yAxisID: 'y'
                        },
                        {
                            label: '{{#str}}average, core{{/str}} /100',
                            data: {{{spec_avg_json}}},
                            backgroundColor: 'rgba(0, 123, 255, 0.75)',
                            borderColor: '#007bff',
                            borderWidth: 1,
                            yAxisID: 'y'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    }
                }
            });
        }

        // Regions Chart
        var regCtx = document.getElementById('regionComparisonChart');
        if (regCtx) {
            new Chart(regCtx, {
                type: 'bar',
                data: {
                    labels: {{{region_labels_json}}},
                    datasets: [
                        {
                            label: '{{#str}}passrate, local_comp_report_ext{{/str}} %',
                            data: {{{region_pass_json}}},
                            backgroundColor: 'rgba(255, 193, 7, 0.85)',
                            borderColor: '#ffc107',
                            borderWidth: 1,
                            yAxisID: 'y'
                        },
                        {
                            label: '{{#str}}average, core{{/str}} /100',
                            data: {{{region_avg_json}}},
                            backgroundColor: 'rgba(23, 162, 184, 0.85)',
                            borderColor: '#17a2b8',
                            borderWidth: 1,
                            yAxisID: 'y'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    }
                }
            });
        }
    }

    // 2. Master Student Table Search and Dynamic Filters
    var searchInput = document.getElementById('rosterSearchInput');
    var specSelect  = document.getElementById('specFilterSelect');
    var regSelect   = document.getElementById('regionFilterSelect');
    var countBadge  = document.getElementById('rosterCountBadge');
    var rows        = document.querySelectorAll('.student-row');

    function filterMasterTable() {
        var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var spec  = specSelect ? specSelect.value.trim() : '';
        var reg   = regSelect ? regSelect.value.trim() : '';
        var visibleCount = 0;

        rows.forEach(function(row) {
            var name  = row.getAttribute('data-name').toLowerCase();
            var id    = row.getAttribute('data-id').toLowerCase();
            var email = row.getAttribute('data-email').toLowerCase();
            var rspec = row.getAttribute('data-spec');
            var rreg  = row.getAttribute('data-region');

            var matchSearch = !query || (name.indexOf(query) !== -1 || id.indexOf(query) !== -1 || email.indexOf(query) !== -1);
            var matchSpec   = !spec || rspec === spec;
            var matchReg    = !reg || rreg === reg;

            if (matchSearch && matchSpec && matchReg) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        if (countBadge) {
            countBadge.textContent = visibleCount;
        }
    }

    if (searchInput) searchInput.addEventListener('input', filterMasterTable);
    if (specSelect) specSelect.addEventListener('change', filterMasterTable);
    if (regSelect) regSelect.addEventListener('change', filterMasterTable);
    {{/has_data}}
});

// 3. Export to CSV (Excel)
function exportInstitutionalExcel() {
    var data = {{{student_list_json}}};
    if (!data || data.length === 0) {
        alert('No data available to export');
        return;
    }

    var csvContent = "\uFEFF";
    csvContent += "ID,Name,Academic ID,Email,Specialization,Region,Group,Theory (/30),Practical (/40),Participation (/20),Assignments (/10),Term Total (/100),GPA Letter,GPA Value,Overall Status\n";

    data.forEach(function(st) {
        var status = st.overall_pass ? "Passed" : "Failed";
        var row = [
            st.id,
            '"' + (st.fullname || '').replace(/"/g, '""') + '"',
            '"' + (st.idnumber || '') + '"',
            '"' + (st.coursename || '').replace(/"/g, '""') + '"',
            '"' + (st.region || '').replace(/"/g, '""') + '"',
            '"' + (st.groupname || '').replace(/"/g, '""') + '"',
            st.best_theory,
            st.best_practical,
            st.participation,
            st.assignments,
            st.term_total,
            st.gpa_letter,
            st.gpa_value,
            status
        ];
        csvContent += row.join(",") + "\n";
    });

    var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.setAttribute("href", url);
    a.setAttribute("download", "Institutional_Master_Report.csv");
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
}
</script>
