    @template local_competency_report/group_quiz_report

    Example context (json):
    {
        "courseid": 2,
        "groups": [
            { "id": 1, "name": "A Grubu", "selected": true },
            { "id": 2, "name": "B Grubu", "selected": false }
        ],
        "quizzes": [
            { "id": 10, "name": "Matematik SÄ±navÄ±", "selected": true },
            { "id": 11, "name": "Fizik SÄ±navÄ±", "selected": false }
        ],
        "has_data": true,
        "competencies": [
            { "shortname": "Y01" },
            { "shortname": "Y02" }
        ],
        "students": [
            {
                "studentlink": "<a href='#'>Ali YÄ±lmaz</a>",
                "scores": [
                    { "rate": "85", "color": "green" },
                    { "rate": "40", "color": "red" }
                ]
            }
