<div class="local_competency_report_group_quiz_report">
    <!-- Consolidated Tab Navigation -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link font-weight-bold text-muted" href="group_competency.php?courseid={{courseid}}"><i class="fa fa-list-alt mr-1"></i> {{#str}}tab_by_competency, local_competency_report{{/str}}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active font-weight-bold" href="#"><i class="fa fa-pencil-square-o mr-1"></i> {{#str}}tab_by_quiz, local_competency_report{{/str}}</a>
        </li>
    </ul>

    <form method="get" class="form-inline mb-4">
        <input type="hidden" name="courseid" value="{{courseid}}">
        
        <select name="groupid" class="form-control mr-2">
            {{#groups}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
            {{/groups}}
        </select>

        <select name="quizid" class="form-control mr-2">
            {{#quizzes}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
            {{/quizzes}}
        </select>

        <button type="submit" class="btn btn-primary mr-2">{{#str}}show, local_competency_report{{/str}}</button>
        {{#has_data}}
            <button id="btn-export-group-quiz-pdf-top" class="btn btn-outline-danger font-weight-bold shadow-sm">
                <i class="fa fa-file-pdf-o mr-1"></i> {{#str}}exportpdf, local_competency_report{{/str}}
            </button>
        {{/has_data}}
    </form>

    {{#has_data}}
        {{#competencies.0}}
        <div class="table-responsive">
            <table class="generaltable table table-bordered table-striped mt-3">
                <thead>
                    <tr>
                        <th>{{#str}}student, local_competency_report{{/str}}</th>
                        {{#competencies}}
                            <th class="text-center">{{shortname}}</th>
                        {{/competencies}}
                    </tr>
                </thead>
                <tbody>
                    {{#students}}
                        <tr>
                            <td>{{{studentlink}}}</td>
                            {{#scores}}
                                <td class="text-center" style="color: {{color}}; font-weight: bold;">
                                    {{#rate}}%{{rate}}{{/rate}}
                                    {{^rate}}-{{/rate}}
                                </td>
                            {{/scores}}
                        </tr>
                    {{/students}}
                </tbody>
                <tfoot>
                    <tr class="table-secondary font-weight-bold">
                        <td>{{#str}}total, local_competency_report{{/str}}</td>
                        {{#totals}}
                            <td class="text-center" style="color: {{color}};">
                                {{#rate}}%{{rate}}{{/rate}}
                                {{^rate}}-{{/rate}}
                            </td>
                        {{/totals}}
                    </tr>
                </tfoot>
            </table>
        </div>
        {{/competencies.0}}
        
        {{^competencies}}
            <div class="alert alert-info">{{#str}}noexamdata, local_competency_report{{/str}}</div>
        {{/competencies}}
        
        {{! Reusable AI Commentary & Focus Widget }}
        {{> local_competency_report/ai_commentary_widget }}
    {{/has_data}}
</div>

{{#js}}
require(['jquery'], function($) {
    $('#btn-export-group-quiz-pdf-top').on('click', function(e) {
        e.preventDefault();
        var editedHtml = '';
        var aiContent = $('.ai-content-html');
        if (aiContent.length && aiContent.html().trim() !== '') {
            editedHtml = aiContent.html();
        }
        
        var form = $('<form>', {
            action: M.cfg.wwwroot + '/local/competency_report/group_quiz_competency_pdf.php',
            method: 'POST',
            target: '_blank'
        });

        var params = {
            courseid: "{{courseid}}",
            groupid: "{{groupid}}",
            quizid: "{{quizid}}",
            pdf_content: editedHtml
        };

        $.each(params, function(key, val) {
            form.append($('<input>', {
                type: 'hidden',
                name: key,
                value: val
            }));
        });

        $('body').append(form);
        form.submit();
        form.remove();
    });
});
{{/js}}
